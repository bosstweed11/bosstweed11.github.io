#usda 1.0
(
    defaultPrim = "World"
    subLayers = [@./site-scene.usda@]
    documentation = "Optional room for the public page (?room=1): walnut table under the clock's feet (y = -0.11), plaster wall and brighter fill."
    metersPerUnit = 1
    upAxis = "Y"
)
over "World"
{
    over "NixieClock"
    {
        over "StudioFill"
        {
            float inputs:intensity = 0.03
        }
        over "Floor"
        {
            token visibility = "invisible"
        }
        def Xform "Room"
        {
        def Mesh "Tabletop"
        {
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [2, 3, 7, 6, 0, 4, 5, 1, 1, 5, 7, 3, 0, 2, 6, 4, 0, 1, 3, 2, 4, 6, 7, 5]
            point3f[] points = [(-0.8, -0.15, -0.42), (-0.8, -0.15, 0.38), (-0.8, -0.11, -0.42), (-0.8, -0.11, 0.38), (0.8, -0.15, -0.42), (0.8, -0.15, 0.38), (0.8, -0.11, -0.42), (0.8, -0.11, 0.38)]
            uniform token subdivisionScheme = "none"
            uniform bool doubleSided = 1
            rel material:binding = </World/NixieClock/SiteLooks/Walnut>
        }
        def Mesh "BackWall"
        {
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            point3f[] points = [(-1.6, -0.15, -0.5), (1.6, -0.15, -0.5), (1.6, 1.1, -0.5), (-1.6, 1.1, -0.5)]
            uniform token subdivisionScheme = "none"
            uniform bool doubleSided = 1
            rel material:binding = </World/NixieClock/SiteLooks/Plaster>
        }
        }
    }
}
