#usda 1.0
(
    defaultPrim = "World"
    subLayers = [@./clock-openexec.usda@]
    documentation = "Public andrew.beer/s/nixie scene: the OpenExec clock in the dark studio on a dark glossy disc, plus web tube LEDs. site-room.usda adds an optional table and wall. Units are meters, Y up."
    metersPerUnit = 1
    upAxis = "Y"
)
over "World"
{
    over "NixieClock"
    {
        def Scope "SiteLooks"
        {
            def Material "Floor"
            {
                token outputs:surface.connect = </World/NixieClock/SiteLooks/Floor/Surface.outputs:surface>
                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.012, 0.011, 0.01)
                    float inputs:roughness = 0.18
                    float inputs:metallic = 0
                    token outputs:surface
                }
            }
            def Material "Walnut"
            {
                token outputs:surface.connect = </World/NixieClock/SiteLooks/Walnut/Surface.outputs:surface>
                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.17, 0.085, 0.04)
                    float inputs:roughness = 0.35
                    token outputs:surface
                }
            }
            def Material "TubeLED"
            {
                token outputs:surface.connect = </World/NixieClock/SiteLooks/TubeLED/Surface.outputs:surface>
                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0, 0, 0)
                    color3f inputs:emissiveColor = (3.4, 1.9, 0.3)
                    float inputs:roughness = 1
                    token outputs:surface
                }
            }
            def Material "Plaster"
            {
                token outputs:surface.connect = </World/NixieClock/SiteLooks/Plaster/Surface.outputs:surface>
                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.32, 0.29, 0.25)
                    float inputs:roughness = 0.9
                    token outputs:surface
                }
            }
        }
        def Mesh "Floor"
