#usda 1.0
(
    defaultPrim = "World"
    subLayers = [
        @clock-scene.usda@
    ]
    timeCodesPerSecond = 1
)

over "World"
{
    over "NixieClock"
    {
        def NixieClock "Behavior"
        {
            custom token exec:displaySetting = "nixie:hour12"
            custom token exec:readout = "nixie:digits"
            custom token exec:timeInput = "nixie:utcSeconds"
            custom bool nixie:hour12 = 0
            custom float nixie:intensity = 1.1
            custom double nixie:utcSeconds = 0
        }

        over "EnclosureHolder"
        {
            over "EnclosureHolder"
            {
                over "EnclosureLeft"
                {
                    over "Cube_017"
                    {
                        token visibility = "invisible"
                    }
                }

                over "EnclosureRight"
                {
                    over "Cube_015"
                    {
                        token visibility = "invisible"
                    }
                }

                over "EnclosureTop"
                {
                    over "Cube_014"
                    {
                        token visibility = "invisible"
                    }
                }

                over "EnclosureBack"
                {
                    over "Cube_013"
                    {
                        token visibility = "invisible"
                    }
                }

                over "EnclosureFront"
                {
                    over "Cube_011"
                    {
                        token visibility = "invisible"
                    }
                }
            }
        }

        over "BigHourTube"
        {
            over "Tube_Prototype"
            {
                over "InsideGlass"
                {
                    over "Tube_001"
                    {
                        token visibility = "invisible"
                    }
                }
            }
        }

        over "BigHourTubeDigits"
        {
            over "Numbers_Lit"
            {
                over "_5_Number_Four_Lit"
                {
                    over "BezierCurve_017" (
                        prepend apiSchemas = ["NixieDigitAPI"]
                    )
                    {
                        custom rel exec:binding:visibility = </World/NixieClock/BigHourTubeDigits/Numbers_Lit/_5_Number_Four_Lit/BezierCurve_017>
                        custom token exec:computation:visibility = "nixie:visibility"
                        custom rel nixie:clock = </World/NixieClock/Behavior>
                        custom int nixie:digit = 4
                        custom int nixie:place = 0
                    }
                }

                over "_2_Number_Seven_Lit"
                {
                    over "BezierCurve_021" (
                        prepend apiSchemas = ["NixieDigitAPI"]
                    )
                    {
                        custom rel exec:binding:visibility = </World/NixieClock/BigHourTubeDigits/Numbers_Lit/_2_Number_Seven_Lit/BezierCurve_021>
                        custom token exec:computation:visibility = "nixie:visibility"
                        custom rel nixie:clock = </World/NixieClock/Behavior>
                        custom int nixie:digit = 7
                        custom int nixie:place = 0
