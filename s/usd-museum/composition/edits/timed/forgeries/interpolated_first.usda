#usda 1.0
(
    defaultPrim = "timed"
    doc = "Forgery interpolated_first on piece timed: interpolated before the edit: the teal marble rises from frame 1, off its ring (0.45 at 73). This is what a viewer with that bug shows; the correct exhibit is ../timed.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 121
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../timed.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "timed"
{
    over "Pieces"
    {
        over "Timed"
        {
            over "Marbles"
            {
                point3f[] positions = None
                point3f[] positions.timeSamples = {
                    1: [(0, 0, 0), (0.4, 0.8, 0)],
                    97: [(0, 0.6, 0), (0.4, 0.8, 0)],
                }
            }
        }
    }
}

