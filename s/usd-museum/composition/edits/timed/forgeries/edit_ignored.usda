#usda 1.0
(
    defaultPrim = "timed"
    doc = "Forgery edit_ignored on piece timed: the edit ignored: the orange marble rises with the teal one, leaving its ring at 0.8. This is what a viewer with that bug shows; the correct exhibit is ../timed.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 121
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../timed.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "timed"
{
    over "Pieces"
    {
        over "Timed"
        {
            over "Marbles"
            {
                point3f[] positions = None
                point3f[] positions.timeSamples = {
                    1: [(0, 0, 0), (0.4, 0, 0)],
                    97: [(0, 0.6, 0), (0.4, 0.6, 0)],
                }
            }
        }
    }
}

