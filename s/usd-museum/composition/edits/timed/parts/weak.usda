#usda 1.0
(
    "composition.edits.timed: the weaker layer: both marbles rise from 0 to 0.6 m (samples at frames 1 and 97)."
    endTimeCode = 121
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Exhibit" (
    kind = "component"
)
{
    def Scope "Looks"
    {
    }

    over "Pieces"
    {
        over "Timed"
        {
            over "Marbles"
            {
                point3f[] positions.timeSamples = {
                    1: [(0, 0, 0), (0.4, 0, 0)],
                    97: [(0, 0.6, 0), (0.4, 0.6, 0)],
                }
            }
        }
    }
}

