#usda 1.0
(
    "Cell rules/lo27-pairwise, the stronger layer: the lo27-stack bench's stronger edit over its weaker one, combined by SdfListOp.ApplyOperations: prototypes delete [Cube]; prepend [Cone]; append [Sphere]."
)

over "Row"
{
    over "Inst"
    {
        delete rel prototypes = </Row/Inst/Protos/Cube>
        prepend rel prototypes = </Row/Inst/Protos/Cone>
        append rel prototypes = </Row/Inst/Protos/Sphere>
    }
}

