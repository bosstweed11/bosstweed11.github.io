#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery lo25_children on piece rules-lo25: nothing + nothing read as every prototype: Cone (LO-25). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "rules_lo25"
        {
            over "Inst"
            {
                custom rel prototypes = </lists/Cells/rules_lo25/Inst/Protos/Cone>
            }
        }
    }
}

