#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery an_append on piece append-none: the end item put first: Sphere, Cone, Prism (LO-16). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "append_none"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/append_none/Inst/Protos/Sphere>,
                    </lists/Cells/append_none/Inst/Protos/Cone>,
                    </lists/Cells/append_none/Inst/Protos/Prism>,
                ]
            }
        }
    }
}

