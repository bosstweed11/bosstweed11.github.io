#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery aa_order on piece append-append: the stronger end before the weaker end: Cone, Prism, Cube, Sphere (LO-21). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "append_append"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/append_append/Inst/Protos/Cone>,
                    </lists/Cells/append_append/Inst/Protos/Prism>,
                    </lists/Cells/append_append/Inst/Protos/Cube>,
                    </lists/Cells/append_append/Inst/Protos/Sphere>,
                ]
            }
        }
    }
}

