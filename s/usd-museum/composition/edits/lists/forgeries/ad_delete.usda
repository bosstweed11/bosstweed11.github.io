#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery ad_delete on piece append-delete: the remove does nothing: Cone, Capsule, Prism, Sphere, Cube (LO-15). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "append_delete"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/append_delete/Inst/Protos/Cone>,
                    </lists/Cells/append_delete/Inst/Protos/Capsule>,
                    </lists/Cells/append_delete/Inst/Protos/Prism>,
                    </lists/Cells/append_delete/Inst/Protos/Sphere>,
                    </lists/Cells/append_delete/Inst/Protos/Cube>,
                ]
            }
        }
    }
}

