#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery dp_order on piece delete-prepend: the weaker remove applied last: Prism, Sphere, Cube (LO-17). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "delete_prepend"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/delete_prepend/Inst/Protos/Prism>,
                    </lists/Cells/delete_prepend/Inst/Protos/Sphere>,
                    </lists/Cells/delete_prepend/Inst/Protos/Cube>,
                ]
            }
        }
    }
}

