#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery ea_leak on piece explicit-append: layers under the plain list still count: Cone, Prism, Cube, Capsule (LO-13). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "explicit_append"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/explicit_append/Inst/Protos/Cone>,
                    </lists/Cells/explicit_append/Inst/Protos/Prism>,
                    </lists/Cells/explicit_append/Inst/Protos/Cube>,
                    </lists/Cells/explicit_append/Inst/Protos/Capsule>,
                    </lists/Cells/explicit_append/Inst/Protos/Sphere>,
                ]
            }
        }
    }
}

