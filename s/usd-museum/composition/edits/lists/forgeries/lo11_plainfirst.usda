#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery lo11_plainfirst on piece rules-lo11-plain: the plain list read as first: Cone, Prism, Sphere, Cube (LO-11). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "rules_lo11_plain"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/rules_lo11_plain/Inst/Protos/Cone>,
                    </lists/Cells/rules_lo11_plain/Inst/Protos/Prism>,
                    </lists/Cells/rules_lo11_plain/Inst/Protos/Sphere>,
                    </lists/Cells/rules_lo11_plain/Inst/Protos/Cube>,
                ]
            }
        }
    }
}

