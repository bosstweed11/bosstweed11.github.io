#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery lo27_middle on piece rules-lo27-stack: the stack's middle layer lost: Prism, Sphere (LO-27). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "rules_lo27_stack"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/rules_lo27_stack/Inst/Protos/Prism>,
                    </lists/Cells/rules_lo27_stack/Inst/Protos/Sphere>,
                ]
            }
        }
    }
}

