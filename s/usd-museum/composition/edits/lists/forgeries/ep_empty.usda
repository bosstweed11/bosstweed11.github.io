#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery ep_empty on piece explicit-prepend: the empty plain list ignored: Cone, Prism, Sphere (LO-06). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "explicit_prepend"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/explicit_prepend/Inst/Protos/Cone>,
                    </lists/Cells/explicit_prepend/Inst/Protos/Prism>,
                    </lists/Cells/explicit_prepend/Inst/Protos/Sphere>,
                    </lists/Cells/explicit_prepend/Inst/Protos/Cube>,
                    </lists/Cells/explicit_prepend/Inst/Protos/Capsule>,
                ]
            }
        }
    }
}

