#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery de_survives on piece delete-explicit: the weaker remove survives the plain list: Prism, Sphere (LO-12). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "delete_explicit"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/delete_explicit/Inst/Protos/Prism>,
                    </lists/Cells/delete_explicit/Inst/Protos/Sphere>,
                ]
            }
        }
    }
}

