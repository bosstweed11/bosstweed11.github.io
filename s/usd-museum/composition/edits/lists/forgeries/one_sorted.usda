#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery one_sorted on piece one-plain: the plain list read sorted: Cone, Cube, Prism, Sphere (LO-08). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "one_plain"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/one_plain/Inst/Protos/Cone>,
                    </lists/Cells/one_plain/Inst/Protos/Cube>,
                    </lists/Cells/one_plain/Inst/Protos/Prism>,
                    </lists/Cells/one_plain/Inst/Protos/Sphere>,
                ]
            }
        }
    }
}

