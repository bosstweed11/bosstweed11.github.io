#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery pd_cancel on piece prepend-delete: the stronger remove misses the weaker first: Cone, Cube, Prism, Sphere (LO-20). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "prepend_delete"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/prepend_delete/Inst/Protos/Cone>,
                    </lists/Cells/prepend_delete/Inst/Protos/Cube>,
                    </lists/Cells/prepend_delete/Inst/Protos/Prism>,
                    </lists/Cells/prepend_delete/Inst/Protos/Sphere>,
                ]
            }
        }
    }
}

