#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery one_endfirst on piece one-first-end: the end items read first: Sphere, Cube, Cone, Prism (LO-09). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "one_first_end"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/one_first_end/Inst/Protos/Sphere>,
                    </lists/Cells/one_first_end/Inst/Protos/Cube>,
                    </lists/Cells/one_first_end/Inst/Protos/Cone>,
                    </lists/Cells/one_first_end/Inst/Protos/Prism>,
                ]
            }
        }
    }
}

