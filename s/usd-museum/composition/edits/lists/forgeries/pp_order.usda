#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery pp_order on piece prepend-prepend: the weaker first before the stronger first: Prism, Cone, Sphere, Cube (LO-19). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "prepend_prepend"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/prepend_prepend/Inst/Protos/Prism>,
                    </lists/Cells/prepend_prepend/Inst/Protos/Cone>,
                    </lists/Cells/prepend_prepend/Inst/Protos/Sphere>,
                    </lists/Cells/prepend_prepend/Inst/Protos/Cube>,
                ]
            }
        }
    }
}

