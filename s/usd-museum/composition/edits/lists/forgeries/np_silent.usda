#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery np_silent on piece none-prepend: a silent weaker layer clears the bottom: Cone (LO-23). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "none_prepend"
        {
            over "Inst"
            {
                custom rel prototypes = </lists/Cells/none_prepend/Inst/Protos/Cone>
            }
        }
    }
}

