#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery lo27_plain on piece rules-lo27-pairwise: the combined pair made a plain list: Cone, Sphere (LO-27). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "rules_lo27_pairwise"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/rules_lo27_pairwise/Inst/Protos/Cone>,
                    </lists/Cells/rules_lo27_pairwise/Inst/Protos/Sphere>,
                ]
            }
        }
    }
}

