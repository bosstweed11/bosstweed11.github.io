#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery dd_replace on piece delete-delete: a stronger remove replaces the weaker: Cone, Cube, Prism, Sphere (LO-15). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "delete_delete"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/delete_delete/Inst/Protos/Cone>,
                    </lists/Cells/delete_delete/Inst/Protos/Cube>,
                    </lists/Cells/delete_delete/Inst/Protos/Prism>,
                    </lists/Cells/delete_delete/Inst/Protos/Sphere>,
                ]
            }
        }
    }
}

