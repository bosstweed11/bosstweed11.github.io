#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery pe_merge on piece prepend-explicit: the plain list keeps weaker items: Cone, Prism, Sphere, Cube (LO-12). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "prepend_explicit"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/prepend_explicit/Inst/Protos/Cone>,
                    </lists/Cells/prepend_explicit/Inst/Protos/Prism>,
                    </lists/Cells/prepend_explicit/Inst/Protos/Sphere>,
                    </lists/Cells/prepend_explicit/Inst/Protos/Cube>,
                    </lists/Cells/prepend_explicit/Inst/Protos/Capsule>,
                ]
            }
        }
    }
}

