#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery one_firstwins on piece one-both-ends: first wins over end: Sphere, Cone, Prism (LO-14). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "one_both_ends"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/one_both_ends/Inst/Protos/Sphere>,
                    </lists/Cells/one_both_ends/Inst/Protos/Cone>,
                    </lists/Cells/one_both_ends/Inst/Protos/Prism>,
                ]
            }
        }
    }
}

