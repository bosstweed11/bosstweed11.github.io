#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery pa_plain on piece prepend-append: instructions over instructions made plain: Cone, Cube (LO-17). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "prepend_append"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/prepend_append/Inst/Protos/Cone>,
                    </lists/Cells/prepend_append/Inst/Protos/Cube>,
                ]
            }
        }
    }
}

