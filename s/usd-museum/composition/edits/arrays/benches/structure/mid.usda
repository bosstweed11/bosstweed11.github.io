#usda 1.0
(
    "Bench structure, the middle layer (array edits): ('insert', 'G', 1)."
    defaultPrim = "Bench"
)

over "Bench"
{
    over "Inst"
    {
        point3f[] positions = edit [insert (0.58, 0, 0) at [1]]
        color3f[] primvars:displayColor = edit [insert (0.2746773, 0.63759685, 0.07818742) at [1]] (
            interpolation = "vertex"
        )
        int[] protoIndices = edit [insert 2 at [1]]
    }
}

