#usda 1.0
(
    "Bench structure bottom: the instancer and its prototypes; plain arrays positions [1, 3, 4]; colors ['arc_inherit', 'arc_specialize', 'arc_relocate']; protos ['Sphere', 'Cube', 'Cone']."
    defaultPrim = "Bench"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Bench" (
    kind = "component"
)
{
    def PointInstancer "Inst"
    {
        float3[] extent = [(-0.11, 0, -0.11), (1.56, 0.22, 0.11)]
        point3f[] positions = [(0.29, 0, 0), (0.87, 0, 0), (1.16, 0, 0)]
        color3f[] primvars:displayColor = [(0.8879231, 0.55201143, 0.0047769533), (0.2704978, 0.104616486, 0.67244315), (0.010329823, 0.31398872, 0.08021982)] (
            interpolation = "vertex"
        )
        int[] protoIndices = [1, 2, 0]
        rel prototypes = [
            </Bench/Inst/Protos/Cone>,
            </Bench/Inst/Protos/Sphere>,
            </Bench/Inst/Protos/Cube>,
        ]

        def Scope "Protos"
        {
            def Xform "Cone" (
                instanceable = true
                prepend references = @../../parts/cone.usda@
            )
            {
            }

            def Xform "Sphere" (
                instanceable = true
                prepend references = @../../parts/sphere.usda@
            )
            {
            }

            def Xform "Cube" (
                instanceable = true
                prepend references = @../../parts/cube.usda@
            )
            {
            }
        }
    }
}

