#usda 1.0
(
    "Bench write bottom: the instancer and its prototypes; plain arrays positions [0, 1, 2, 6, 4, 5]; colors ['arc_local', 'key', 'key', 'arc_relocate', 'arc_reference', 'arc_reference']; protos ['Cone', 'Cube', 'Sphere', 'Cube', 'Cone', 'Cube']."
    defaultPrim = "Bench"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Bench" (
    kind = "component"
)
{
    def PointInstancer "Inst"
    {
        float3[] extent = [(-0.11, 0, -0.11), (1.85, 0.22, 0.11)]
        point3f[] positions = [(0, 0, 0), (0.29, 0, 0), (0.58, 0, 0), (1.74, 0, 0), (1.16, 0, 0), (1.45, 0, 0)]
        color3f[] primvars:displayColor = [(0.91309863, 0.22322796, 0.030713445), (0.3231432, 0.3231432, 0.3231432), (0.3231432, 0.3231432, 0.3231432), (0.010329823, 0.31398872, 0.08021982), (0.024157632, 0.462077, 0.58407843), (0.024157632, 0.462077, 0.58407843)] (
            interpolation = "vertex"
        )
        int[] protoIndices = [0, 2, 1, 2, 0, 2]
        rel prototypes = [
            </Bench/Inst/Protos/Cone>,
            </Bench/Inst/Protos/Sphere>,
            </Bench/Inst/Protos/Cube>,
        ]

        def Scope "Protos"
        {
            def Xform "Cone" (
                instanceable = true
                prepend references = @../../parts/cone.usda@
            )
            {
            }

            def Xform "Sphere" (
                instanceable = true
                prepend references = @../../parts/sphere.usda@
            )
            {
            }

            def Xform "Cube" (
                instanceable = true
                prepend references = @../../parts/cube.usda@
            )
            {
            }
        }
    }
}

