#usda 1.0
(
    "USD Museum exhibit composition.edits.arrays: array edits across layers, three benches in steps. Each bench's shapes are a PointInstancer whose positions, displayColor and protoIndices compose a bottom array and two layers of array edits; each shape stands over its silhouette, and every red outline stays empty. Built by src/build.py."
    defaultPrim = "Exhibit"
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

