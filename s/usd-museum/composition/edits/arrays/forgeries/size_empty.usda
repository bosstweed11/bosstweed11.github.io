#usda 1.0
(
    defaultPrim = "arrays"
    doc = "Forgery size_empty on piece size: an edit over nothing refused: an empty bench, every silhouette bare. This is what a viewer with that bug shows; the correct exhibit is ../arrays.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../arrays.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "arrays"
{
    over "Benches"
    {
        over "Size"
        {
            over "Inst"
            {
                point3f[] positions = []
                color3f[] primvars:displayColor = [] (
                    interpolation = "vertex"
                )
                int[] protoIndices = []
            }
        }
    }
}

