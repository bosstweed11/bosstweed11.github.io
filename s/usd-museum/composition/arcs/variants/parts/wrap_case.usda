#usda 1.0
(
    "composition.arcs.variants: the wrap asset. /Case: variant set wrap (stripes, dots, checks, redx), no selection; the stripes variant nests the set trim (plain, gold). /CaseDefault: /Case with the asset's own selection, wrap = stripes."
    defaultPrim = "Case"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Case" (
    kind = "component"
    prepend variantSets = "wrap"
)
{
    def Scope "Looks"
    {
        def Material "band_stripes"
        {
            token outputs:surface.connect = </Case/Looks/band_stripes/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor.connect = </Case/Looks/band_stripes/Tex.outputs:rgb>
                float inputs:opacity.connect = </Case/Looks/band_stripes/Tex.outputs:a>
                float inputs:opacityThreshold = 0.5
                float inputs:roughness = 1
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/band_stripes.png@
                float4 inputs:scale = (1, 1, 1, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Case/Looks/band_stripes/St.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:a
                float3 outputs:rgb
            }
        }

