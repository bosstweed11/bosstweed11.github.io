#usda 1.0
(
    defaultPrim = "variants"
    doc = "Exhibit composition.arcs.variants: Variant selections and fallbacks. Look for: every band matches the swatch on its pedestal. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "variants" (
    prepend apiSchemas = ["AuthorshipAPI:claude", "AuthorshipAPI:build", "AssetPreviewsAPI"]
    assetInfo = {
        asset identifier = @./variants.usda@
        string name = "variants"
        dictionary previews = {
            dictionary thumbnails = {
                dictionary default = {
                    asset defaultImage = @./thumbnail.jpg@
                }
            }
        }
    }
    customData = {
        dictionary museum = {
            string[] belt = ["02.Variants"]
            string id = "composition.arcs.variants"
            string look_for = "every band matches the swatch on its pedestal"
            string[] spec = ["composition"]
            string title = "Variant selections and fallbacks"
            string wg = "core"
        }
    }
    kind = "assembly"
    prepend payload = @./payload.usda@
)
{
    uniform string authorship:build:created = "2026-11-12T21:58:11-08:00"
    uniform string[] authorship:build:creator = ["usd-tour museum/src/export.py"]
    uniform string authorship:build:description = "Written through OpenUSD's Python API by usd-tour's build and export scripts (written by Claude Opus 5.5)."
    uniform string authorship:build:digitalSourceType = "http://cv.iptc.org/newscodes/digitalsourcetype/algorithmicMedia"
    uniform string[] authorship:build:inputs = ["source", "usd-tour d664ad2"]
    uniform string authorship:build:softwarePackage = "OpenUSD"
    uniform string authorship:build:softwareVersion = "26.11"
    uniform string authorship:build:usageTerms = "CC0-1.0"
    uniform string authorship:claude:created = "2026-11-12T21:58:11-08:00"
    uniform string[] authorship:claude:creator = ["Claude Opus 5.5 (Anthropic)"]
    uniform string authorship:claude:description = "Claude Opus 5.5, working in Claude Code, built every prim in this museum: it designed the exhibits and wrote the usd-tour scripts that author them."
    uniform string authorship:claude:digitalSourceType = "http://cv.iptc.org/newscodes/digitalsourcetype/trainedAlgorithmicMedia"
    uniform string[] authorship:claude:inputs = ["source", "usd-tour d664ad2"]
    uniform string authorship:claude:softwarePackage = "com.anthropic.claude"
    uniform string authorship:claude:softwareVersion = "claude-opus-5-5"
    uniform string authorship:claude:usageTerms = "CC0-1.0"
    float3[] extentsHint = [(-2.8, 0, -1.5), (2.8, 2.55, -0.19)]

    over "Pieces"
    {
        over "default" (
            customData = {
                dictionary museum = {
                    string[] belt = ["02.Variants/default"]
                    string[] features = ["COMP-VARIANTS", "COMP-ARCS-IN-VARIANTS"]
                    string[] forgeries = ["nodefault"]
                    string reference = "a stripes swatch"
                    string[] spec = ["composition#variants", "composition#computing-variant-selection"]
                }
            }
            doc = "the asset's own selection (stripes)"
        )
        {
        }

        over "stronger" (
            customData = {
                dictionary museum = {
                    string[] belt = ["02.Variants/stronger layer"]
                    string[] features = ["COMP-VARIANTS", "COMP-VARIANT-SELECTION-ORDER"]
                    string[] forgeries = ["weakwins"]
                    string reference = "a dots swatch"
                    string[] rules = ["STR-16"]
                    string[] spec = ["composition#computing-variant-selection"]
                }
            }
            doc = "this layer's selection (dots) beats the weaker sublayer's (redx)"
        )
        {
        }

        over "fallback" (
            customData = {
                dictionary museum = {
                    string[] belt = ["02.Variants/plugin fallback"]
                    string[] features = ["COMP-VARIANTS", "COMP-VARIANT-FALLBACK"]
                    string[] forgeries = ["nofallback"]
                    string reference = "a checks swatch"
                    string[] spec = ["composition#computing-variant-selection"]
                }
            }
            doc = "no selection anywhere: the plugin fallback (wrap = checks)"
        )
        {
        }

        over "nested" (
            customData = {
                dictionary museum = {
                    string[] belt = ["02.Variants/nested"]
                    string[] features = ["COMP-VARIANTS-NESTED", "COMP-ARCS-IN-VARIANTS"]
                    string[] forgeries = ["nonested"]
                    string reference = "a stripes swatch with gold edges"
                    string[] spec = ["composition#variants"]
                }
            }
            doc = "a variant set inside the stripes variant, selected gold"
        )
        {
        }
    }
}

