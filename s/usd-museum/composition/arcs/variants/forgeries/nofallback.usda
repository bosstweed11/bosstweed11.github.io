#usda 1.0
(
    defaultPrim = "variants"
    doc = "Forgery nofallback on piece fallback: the plugin fallback ignored: no band against the checks swatch. This is what a viewer with that bug shows; the correct exhibit is ../variants.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../variants.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "variants"
{
    over "Pieces"
    {
        over "fallback"
        {
            over "Case" (
                variants = {
                    string wrap = "unselected"
                }
            )
            {
            }
        }
    }
}

