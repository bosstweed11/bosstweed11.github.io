#usda 1.0
(
    defaultPrim = "variants"
    doc = "Forgery weakwins on piece stronger: the weaker layer's selection wins: the red-x band against the dots swatch. This is what a viewer with that bug shows; the correct exhibit is ../variants.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../variants.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "variants"
{
    over "Pieces"
    {
        over "stronger"
        {
            over "Case" (
                variants = {
                    string wrap = "redx"
                }
            )
            {
            }
        }
    }
}

