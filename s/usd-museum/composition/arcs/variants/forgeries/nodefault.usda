#usda 1.0
(
    defaultPrim = "variants"
    doc = "Forgery nodefault on piece default: the asset's selection ignored (the fallback used): checks against the stripes swatch. This is what a viewer with that bug shows; the correct exhibit is ../variants.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../variants.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "variants"
{
    over "Pieces"
    {
        over "default"
        {
            over "Case" (
                variants = {
                    string wrap = "checks"
                }
            )
            {
            }
        }
    }
}

