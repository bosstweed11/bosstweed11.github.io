#usda 1.0
(
    "USD Museum exhibit composition.arcs.variants: variant selections and fallbacks. Each case's band must match the swatch on its pedestal. Built by src/build.py."
    defaultPrim = "Exhibit"
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @./weak.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Exhibit" (
    kind = "assembly"
)
{
    float3[] extentsHint = [(-2.8, 0, -1.5), (2.8, 2.55, -0.19)]

