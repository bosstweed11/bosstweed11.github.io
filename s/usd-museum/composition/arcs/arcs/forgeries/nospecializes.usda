#usda 1.0
(
    defaultPrim = "arcs"
    doc = "Forgery nospecializes on piece specializes: specializes not followed: the tag slot is empty. This is what a viewer with that bug shows; the correct exhibit is ../arcs.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../arcs.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "arcs"
{
    over "Pieces"
    {
        over "specializes"
        {
            over "Case"
            {
                over "Tag" (
                    active = false
                )
                {
                }
            }
        }
    }
}

