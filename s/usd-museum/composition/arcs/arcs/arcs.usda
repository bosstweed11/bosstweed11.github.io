#usda 1.0
(
    defaultPrim = "arcs"
    doc = "Exhibit composition.arcs.arcs: What each arc brings. Look for: every part fills its outlined slot; the red slot stays empty. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "arcs" (
    prepend apiSchemas = ["AuthorshipAPI:claude", "AuthorshipAPI:build", "AssetPreviewsAPI"]
    assetInfo = {
        asset identifier = @./arcs.usda@
        string name = "arcs"
        dictionary previews = {
            dictionary thumbnails = {
                dictionary default = {
                    asset defaultImage = @./thumbnail.jpg@
                }
            }
        }
    }
    customData = {
        dictionary museum = {
            string[] belt = ["02.Arcs"]
            string id = "composition.arcs.arcs"
            string look_for = "every part fills its outlined slot; the red slot stays empty"
            string[] spec = ["composition"]
            string title = "What each arc brings"
            string wg = "core"
        }
    }
    kind = "assembly"
    prepend payload = @./payload.usda@
)
{
    uniform string authorship:build:created = "2026-11-13T20:04:05-08:00"
    uniform string[] authorship:build:creator = ["usd-tour museum/src/export.py"]
    uniform string authorship:build:description = "Written through OpenUSD's Python API by usd-tour's build and export scripts (written by Claude Opus 5.5)."
    uniform string authorship:build:digitalSourceType = "http://cv.iptc.org/newscodes/digitalsourcetype/algorithmicMedia"
    uniform string[] authorship:build:inputs = ["source", "usd-tour 5103439"]
    uniform string authorship:build:softwarePackage = "OpenUSD"
    uniform string authorship:build:softwareVersion = "26.11"
    uniform string authorship:build:usageTerms = "CC0-1.0"
    uniform string authorship:claude:created = "2026-11-13T20:04:05-08:00"
    uniform string[] authorship:claude:creator = ["Claude Opus 5.5 (Anthropic)"]
    uniform string authorship:claude:description = "Claude Opus 5.5, working in Claude Code, built every prim in this museum: it designed the exhibits and wrote the usd-tour scripts that author them."
    uniform string authorship:claude:digitalSourceType = "http://cv.iptc.org/newscodes/digitalsourcetype/trainedAlgorithmicMedia"
    uniform string[] authorship:claude:inputs = ["source", "usd-tour 5103439"]
    uniform string authorship:claude:softwarePackage = "com.anthropic.claude"
    uniform string authorship:claude:softwareVersion = "claude-opus-5-5"
    uniform string authorship:claude:usageTerms = "CC0-1.0"
    float3[] extentsHint = [(-2.85, 0, -1.5), (2.85, 2.55, -0.16889317)]

    over "Pieces"
    {
        over "inherit" (
            customData = {
                dictionary museum = {
                    string[] belt = ["02.Arcs/implied inherits"]
                    string[] features = ["COMP-INHERITS", "COMP-IMPLIED-INHERITS", "SCENE-SPECIFIER"]
                    string[] forgeries = ["noimplied", "noinherit"]
                    string reference = "outlined stamp slot on the case front"
                    string[] spec = ["composition#inherits"]
                }
            }
            doc = "the PRIORITY stamp, from a class this layer overrides (implied inherit)"
        )
        {
        }

        over "specializes" (
            customData = {
                dictionary museum = {
                    string[] belt = ["02.Arcs/specializes", "02.Arcs/local over specializes"]
                    string[] features = ["COMP-SPECIALIZES", "COMP-LOCAL"]
                    string[] forgeries = ["nospecializes", "specwins"]
                    string reference = "outlined tag slot over a blue ledge"
                    string[] rules = ["STR-11", "STR-15"]
                    string[] spec = ["composition#specializes"]
                }
            }
            doc = "the FRAGILE tag from the library, painted blue by the local opinion"
        )
        {
        }

        over "internal" (
            customData = {
                dictionary museum = {
                    string[] belt = ["02.Arcs/internal reference"]
                    string[] features = ["COMP-REF-INTERNAL"]
                    string[] forgeries = ["nointernal"]
                    string reference = "outlined handle slot on top"
                    string[] spec = ["composition#references"]
                }
            }
            doc = "the carry handle, an internal reference to /Exhibit/_Parts/Handle"
        )
        {
        }

        over "subroot" (
            customData = {
                dictionary museum = {
                    string[] belt = ["02.Arcs/sub-root reference"]
                    string[] features = ["COMP-REF-SUBROOT"]
                    string[] forgeries = ["wholerack"]
                    string reference = "outlined side-handle slot"
                    string[] spec = ["composition#references"]
                }
            }
            doc = "only the brass handle of parts/rack.usda, a sub-root reference"
        )
        {
        }

        over "stickers" (
            customData = {
                dictionary museum = {
                    string[] belt = ["02.Arcs/prepend + append", "02.Arcs/list-op delete"]
                    string[] features = ["COMP-LISTEDIT-ARCS", "VAL-LISTOPS"]
                    string[] forgeries = ["nodelete", "noappend", "noprepend"]
                    string reference = "numbered sticker slots; a red slot that stays empty"
                    string[] rules = ["LO-13", "LO-15", "LO-16"]
                    string[] spec = ["composition#composition-arcs", "foundational_data_types#combining-1"]
                }
            }
            doc = "stickers 1 2 3 from references list-edited across two layers; the X deleted"
        )
        {
        }
    }
}

