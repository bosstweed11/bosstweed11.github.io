#usda 1.0
(
    defaultPrim = "payloads"
    doc = "Forgery nonested on piece nested: the payload inside the payload not loaded: the stand without its vase. This is what a viewer with that bug shows; the correct exhibit is ../payloads.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../payloads.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "payloads"
{
    over "Pieces"
    {
        over "nested"
        {
            over "Item"
            {
                over "Holder" (
                    kind = ""
                )
                {
                    float primvars:displayColor = None

                    over "Looks" (
                        active = false
                    )
                    {
                    }

                    over "Body" (
                        active = false
                        instanceable = false
                    )
                    {
                    }
                }
            }
        }
    }
}

