#usda 1.0
(
    defaultPrim = "payloads"
    doc = "Forgery unselected on piece unselected: the unselected variant's payload composed: a vase in the red outline. This is what a viewer with that bug shows; the correct exhibit is ../payloads.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../payloads.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "payloads"
{
    over "Pieces"
    {
        over "unselected"
        {
            over "Item" (
                variants = {
                    string stock = "full"
                }
            )
            {
            }
        }
    }
}

