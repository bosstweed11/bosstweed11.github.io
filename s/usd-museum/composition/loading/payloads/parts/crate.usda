#usda 1.0
(
    "composition.loading.payloads: the payload asset: one vase in the payload color (the color is authored here, so it arrives through the payload)."
    defaultPrim = "Crate"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Crate" (
    kind = "component"
)
{
    color3f[] primvars:displayColor = [(0.04231141, 0.15896083, 0.6866853)] (
        interpolation = "constant"
    )

    def Scope "Looks"
    {
    }

    def Xform "Body" (
        instanceable = true
        prepend references = @./vase.usda@
    )
    {
        matrix4d xformOp:transform = ( (1.3, 0, 0, 0), (0, 1.3, 0, 0), (0, 0, 1.3, 0), (0, 0.003, 0, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }
}

