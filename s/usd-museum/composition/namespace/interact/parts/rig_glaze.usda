#usda 1.0
(
    "composition.namespace.interact: a rig whose vase sits at OldSpot/Vase; NewSpot is empty; the vase and a jar bind Vase/Looks/Glaze by its old path."
    defaultPrim = "Rig"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Rig" (
    kind = "component"
)
{
    def Scope "Looks"
    {
    }

    def Xform "OldSpot"
    {
        double3 xformOp:translate = (-0.62, 0.7, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "Vase" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Rig/OldSpot/Vase/Looks/Glaze> (
                bindMaterialAs = "strongerThanDescendants"
            )
            color3f[] primvars:displayColor = [(0.63075715, 0.000607054, 0.010960094)] (
                interpolation = "constant"
            )
            float3 xformOp:scale = (1.5, 1.5, 1.5)
            uniform token[] xformOpOrder = ["xformOp:scale"]

            def "Body" (
                prepend references = @./vase.usda@
            )
            {
            }

            def "Looks"
            {
                def Material "Glaze"
                {
                    token outputs:surface.connect = </Rig/OldSpot/Vase/Looks/Glaze/Surface.outputs:surface>

                    def Shader "Surface"
                    {
                        uniform token info:id = "UsdPreviewSurface"
                        color3f inputs:diffuseColor = (0.91309863, 0.22322796, 0.030713445)
                        float inputs:roughness = 0.55
                        color3f inputs:specularColor = (0.04, 0.04, 0.04)
                        int inputs:useSpecularWorkflow = 1
                        token outputs:surface
                    }
                }
            }
        }
    }

    def Xform "NewSpot"
    {
        double3 xformOp:translate = (0, 0.82, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Jar" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Rig/OldSpot/Vase/Looks/Glaze> (
            bindMaterialAs = "strongerThanDescendants"
        )
        float3 xformOp:scale = (1.725, 1.08, 1.725)
        double3 xformOp:translate = (0.7, 0.82, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

        def "Body" (
            prepend references = @./vase.usda@
        )
        {
        }
    }
}

