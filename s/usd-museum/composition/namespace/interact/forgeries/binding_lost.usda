#usda 1.0
(
    defaultPrim = "interact"
    doc = "Forgery binding_lost on piece binding: the bindings not remapped: a red vase and a bare jar on orange. This is what a viewer with that bug shows; the correct exhibit is ../interact.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../interact.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "interact"
{
    over "Pieces"
    {
        over "Binding"
        {
            over "NewSpot"
            {
                over "Vase"
                {
                    custom rel material:binding = None
                }
            }

            over "Jar"
            {
                custom rel material:binding = None
            }
        }
    }
}

