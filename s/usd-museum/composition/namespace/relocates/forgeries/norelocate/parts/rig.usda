#usda 1.0
(
    "composition.namespace.relocates: the rig. Its vase is at OldSpot/Vase in the rig's own red; NewSpot is an empty spot over the other pedestal."
    defaultPrim = "Rig"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Rig" (
    kind = "component"
)
{
    def Scope "Looks"
    {
    }

    def Xform "OldSpot"
    {
        double3 xformOp:translate = (-1.05, 0.7, -0.65)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "Vase"
        {
            color3f[] primvars:displayColor = [(0.63075715, 0.000607054, 0.010960094)] (
                interpolation = "constant"
            )
            float3 xformOp:scale = (2.2, 2.2, 2.2)
            uniform token[] xformOpOrder = ["xformOp:scale"]

            def "Body" (
                instanceable = true
                prepend references = @./vase.usda@
            )
            {
            }
        }
    }

    def Xform "NewSpot"
    {
        double3 xformOp:translate = (1.05, 0.7, -0.65)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

