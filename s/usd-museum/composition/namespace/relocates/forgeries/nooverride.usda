#usda 1.0
(
    defaultPrim = "relocates"
    doc = "Forgery nooverride on piece moved: the new-path override lost: a red vase on the teal base. This is what a viewer with that bug shows; the correct exhibit is ../relocates.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../relocates.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "relocates"
{
    over "Pieces"
    {
        over "Rig"
        {
            over "NewSpot"
            {
                over "Vase"
                {
                    color3f[] primvars:displayColor = [(0.63075715, 0.000607054, 0.010960094)] (
                        interpolation = "constant"
                    )
                }
            }
        }
    }
}

