#usda 1.0
(
    "USD Museum exhibit composition.namespace.mapping: seven vases whose material bindings and shader connections were authored inside their assets; brought in through each arc under a new path, each must still reach its own glaze and match its base. Built by src/build.py."
    defaultPrim = "Exhibit"
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
    relocates = {
        </Exhibit/Pieces/Relocate/Vase/Paint>: </Exhibit/Pieces/Relocate/Vase/Coat>
    }
)

def Xform "Exhibit" (
    kind = "assembly"
)
{
    float3[] extentsHint = [(-2.43, 0, -1.3), (2.43, 2.1, -0.264)]

