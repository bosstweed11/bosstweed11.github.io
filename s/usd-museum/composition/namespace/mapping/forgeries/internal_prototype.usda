#usda 1.0
(
    defaultPrim = "mapping"
    doc = "Forgery internal_prototype on piece internal: the internal copy still bound to the prototype's glaze (under the class): a red vase. This is what a viewer with that bug shows; the correct exhibit is ../mapping.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../mapping.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "mapping"
{
    over "Pieces"
    {
        over "Internal"
        {
            over "Vase"
            {
                over "Body" (
                    instanceable = false
                )
                {
                    custom rel material:binding = </mapping/Lib/Vase/Looks/Glaze>
                }
            }
        }
    }
}

