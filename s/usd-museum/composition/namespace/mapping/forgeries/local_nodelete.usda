#usda 1.0
(
    defaultPrim = "mapping"
    doc = "Forgery local_nodelete on piece local: the stronger delete misses the translated red source: red stays first. This is what a viewer with that bug shows; the correct exhibit is ../mapping.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../mapping.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "mapping"
{
    over "Pieces"
    {
        over "Local"
        {
            over "Vase"
            {
                over "Looks"
                {
                    over "Glaze"
                    {
                        over "Surface"
                        {
                            color3f inputs:diffuseColor = (0.63075715, 0.000607054, 0.010960094)
                            color3f inputs:diffuseColor.connect = [
                                </mapping/Pieces/Local/Vase/Looks/Glaze.inputs:red>,
                                </mapping/Pieces/Local/Vase/Looks/Glaze.inputs:orange>,
                            ]
                        }
                    }
                }
            }
        }
    }
}

