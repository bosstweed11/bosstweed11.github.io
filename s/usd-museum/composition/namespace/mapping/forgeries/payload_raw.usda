#usda 1.0
(
    defaultPrim = "mapping"
    doc = "Forgery payload_raw on piece payload: the binding not forwarded past Hub.pick: unbound, a red vase. This is what a viewer with that bug shows; the correct exhibit is ../mapping.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../mapping.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "mapping"
{
    over "Pieces"
    {
        over "Payload"
        {
            over "Vase"
            {
                over "Hub"
                {
                    custom rel next = None
                    custom rel pick = None
                }
            }
        }
    }
}

