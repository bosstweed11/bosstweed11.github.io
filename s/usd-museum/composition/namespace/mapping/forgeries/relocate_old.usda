#usda 1.0
(
    defaultPrim = "mapping"
    doc = "Forgery relocate_old on piece relocate: the binding left at the old Paint path: unbound, a red vase. This is what a viewer with that bug shows; the correct exhibit is ../mapping.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../mapping.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "mapping"
{
    over "Pieces"
    {
        over "Relocate"
        {
            over "Vase"
            {
                over "Body" (
                    instanceable = false
                )
                {
                    custom rel material:binding = </mapping/Pieces/Relocate/Vase/Paint/Glaze>
                }
            }
        }
    }
}

