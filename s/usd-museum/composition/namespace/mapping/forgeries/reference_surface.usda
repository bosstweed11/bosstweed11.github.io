#usda 1.0
(
    defaultPrim = "mapping"
    doc = "Forgery reference_surface on piece reference: the material's surface output not re-pathed: no surface, a red vase. This is what a viewer with that bug shows; the correct exhibit is ../mapping.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../mapping.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "mapping"
{
    over "Pieces"
    {
        over "Reference"
        {
            over "Vase"
            {
                over "Looks"
                {
                    over "Glaze"
                    {
                        token outputs:surface = None
                        token outputs:surface.connect = None
                    }
                }
            }
        }
    }
}

