#usda 1.0
(
    "composition.namespace.mapping, the local asset: its glaze's diffuseColor connects to inputs:red; the exhibit's stronger layer deletes that connection (by its translated path) and appends inputs:orange."
    defaultPrim = "Vase"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Vase" (
    kind = "component"
)
{
    color3f[] primvars:displayColor = [(0.63075715, 0.000607054, 0.010960094)] (
        interpolation = "constant"
    )

    def Scope "Looks"
    {
        def Material "Glaze"
        {
            color3f inputs:glaze = (0.91309863, 0.22322796, 0.030713445)
            color3f inputs:orange = (0.91309863, 0.22322796, 0.030713445)
            color3f inputs:red = (0.63075715, 0.000607054, 0.010960094)
            token outputs:surface.connect = </Vase/Looks/Glaze/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.63075715, 0.000607054, 0.010960094)
                color3f inputs:diffuseColor.connect = </Vase/Looks/Glaze.inputs:red>
                float inputs:roughness = 0.55
                color3f inputs:specularColor = (0.04, 0.04, 0.04)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

    def Xform "Body" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        instanceable = true
        prepend references = @./vase.usda@
    )
    {
        rel material:binding = </Vase/Looks/Glaze>
    }
}

