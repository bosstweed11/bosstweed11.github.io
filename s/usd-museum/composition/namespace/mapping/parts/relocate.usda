#usda 1.0
(
    "composition.namespace.mapping, the relocate asset: its glaze is at </Vase/Paint/Glaze>; the exhibit relocates Paint to Coat, and the Body's binding must follow to Coat/Glaze."
    defaultPrim = "Vase"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Vase" (
    kind = "component"
)
{
    color3f[] primvars:displayColor = [(0.63075715, 0.000607054, 0.010960094)] (
        interpolation = "constant"
    )

    def Scope "Looks"
    {
    }

    def Scope "Paint"
    {
        def Material "Glaze"
        {
            color3f inputs:glaze = (0.010329823, 0.31398872, 0.08021982)
            token outputs:surface.connect = </Vase/Paint/Glaze/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.63075715, 0.000607054, 0.010960094)
                color3f inputs:diffuseColor.connect = </Vase/Paint/Glaze.inputs:glaze>
                float inputs:roughness = 0.55
                color3f inputs:specularColor = (0.04, 0.04, 0.04)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

    def Xform "Body" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        instanceable = true
        prepend references = @./vase.usda@
    )
    {
        rel material:binding = </Vase/Paint/Glaze>
    }
}

