#usda 1.0
(
    "composition.namespace.mapping, the reference asset: the Body binds </Vase/Looks/Glaze>; the glaze's surface output and its color connection are paths inside the asset."
    defaultPrim = "Vase"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Vase" (
    kind = "component"
)
{
    color3f[] primvars:displayColor = [(0.63075715, 0.000607054, 0.010960094)] (
        interpolation = "constant"
    )

    def Scope "Looks"
    {
        def Material "Glaze"
        {
            color3f inputs:glaze = (0.024157632, 0.462077, 0.58407843)
            token outputs:surface.connect = </Vase/Looks/Glaze/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.63075715, 0.000607054, 0.010960094)
                color3f inputs:diffuseColor.connect = </Vase/Looks/Glaze.inputs:glaze>
                float inputs:roughness = 0.55
                color3f inputs:specularColor = (0.04, 0.04, 0.04)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

    def Xform "Body" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        instanceable = true
        prepend references = @./vase.usda@
    )
    {
        rel material:binding = </Vase/Looks/Glaze>
    }
}

