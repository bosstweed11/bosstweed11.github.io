#usda 1.0
(
    defaultPrim = "cycles"
    doc = "Exhibit composition.errors.cycles: Diamonds and cycles. Look for: every vase fills its ghost, every tag its slot; the three red outlines stay empty. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "cycles" (
    prepend apiSchemas = ["AuthorshipAPI:claude", "AuthorshipAPI:build", "AssetPreviewsAPI"]
    assetInfo = {
        asset identifier = @./cycles.usda@
        string name = "cycles"
        dictionary previews = {
            dictionary thumbnails = {
                dictionary default = {
                    asset defaultImage = @./thumbnail.jpg@
                }
            }
        }
    }
    customData = {
        dictionary museum = {
            string[] belt = ["04.Diamond"]
            string expected_errors = "composition cycles (reference, inherit and sublayer), on purpose: the exhibit shows what a viewer must still draw when USD reports a cycle"
            string id = "composition.errors.cycles"
            string look_for = "every vase fills its ghost, every tag its slot; the three red outlines stay empty"
            string[] spec = ["composition"]
            string title = "Diamonds and cycles"
            string wg = "core"
        }
    }
    kind = "assembly"
    prepend payload = @./payload.usda@
)
{
    uniform string authorship:build:created = "2026-11-12T20:35:05-08:00"
    uniform string[] authorship:build:creator = ["usd-tour museum/src/export.py"]
    uniform string authorship:build:description = "Written through OpenUSD's Python API by usd-tour's build and export scripts (written by Claude Opus 5.5)."
    uniform string authorship:build:digitalSourceType = "http://cv.iptc.org/newscodes/digitalsourcetype/algorithmicMedia"
    uniform string[] authorship:build:inputs = ["source", "usd-tour 91b777d"]
    uniform string authorship:build:softwarePackage = "OpenUSD"
    uniform string authorship:build:softwareVersion = "26.11"
    uniform string authorship:build:usageTerms = "CC0-1.0"
    uniform string authorship:claude:created = "2026-11-12T20:35:05-08:00"
    uniform string[] authorship:claude:creator = ["Claude Opus 5.5 (Anthropic)"]
    uniform string authorship:claude:description = "Claude Opus 5.5, working in Claude Code, built every prim in this museum: it designed the exhibits and wrote the usd-tour scripts that author them."
    uniform string authorship:claude:digitalSourceType = "http://cv.iptc.org/newscodes/digitalsourcetype/trainedAlgorithmicMedia"
    uniform string[] authorship:claude:inputs = ["source", "usd-tour 91b777d"]
    uniform string authorship:claude:softwarePackage = "com.anthropic.claude"
    uniform string authorship:claude:softwareVersion = "claude-opus-5-5"
    uniform string authorship:claude:usageTerms = "CC0-1.0"

    over "Pieces"
    {
        over "diamond" (
            customData = {
                dictionary museum = {
                    string[] belt = ["04.Diamond/base composed once", "04.Diamond/two references", "04.Diamond/first wins"]
                    string[] features = ["COMP-DIAMOND-CYCLE.diamond", "COMP-REF"]
                    string[] forgeries = ["twice", "lastwins", "onearm"]
                    string reference = "the vase's ghost; outlined slots for tag A (cube) and tag B (sphere); a red outline where arm B would put the vase"
                    string[] spec = ["composition#references", "composition#composition-arcs"]
                }
            }
            doc = "Case references arm A then arm B; both reference shared.usda (the vase). The shared layer composes once, both arms contribute a tag, and the shared layer reached through arm A beats arm B's move and red paint"
        )
        {
        }

        over "refcycle" (
            customData = {
                dictionary museum = {
                    string[] features = ["COMP-DIAMOND-CYCLE.cycles", "COMP-ERRORS"]
                    string[] forgeries = ["reffollowed", "refrefused"]
                    string reference = "the vase's ghost; the tag's slot; a red outline over Loop that stays empty"
                    string[] spec = ["composition#references"]
                }
            }
            doc = "Case references cyc_a.usda</A> (the vase), which references cyc_b.usda</B> (the tag); B/Loop references cyc_a.usda</A> again. The cycling arc is reported and ignored; the rest composes"
        )
        {
        }

        over "inhcycle" (
            customData = {
                dictionary museum = {
                    string[] features = ["COMP-DIAMOND-CYCLE.cycles", "COMP-ERRORS", "COMP-INHERITS"]
                    string[] forgeries = ["inhfollowed", "inhrefused"]
                    string reference = "the vase's ghost (Case's own vase); the tag's slot; a red outline over Child that stays empty"
                    string[] spec = ["composition#inherits"]
                }
            }
            doc = "Case/Child inherits its own parent, Case (a cycle), and the class _Classes/Tagged. The cycling inherit is ignored; the healthy one brings the tag"
        )
        {
        }

        over "sublayer" (
            customData = {
                dictionary museum = {
                    string[] features = ["COMP-DIAMOND-CYCLE.cycles", "COMP-ERRORS", "LAYER-SUBLAYER"]
                    string[] forgeries = ["subrefused", "subdropped"]
                    string reference = "the vase's ghost; the tag's slot"
                    string[] spec = ["composition#sublayers"]
                }
            }
            doc = "Case references sub_a.usda (the tag), whose sublayer sub_b.usda (the vase) sublayers sub_a.usda again. The cycling entry is ignored; the asset still opens"
        )
        {
        }
    }
}

