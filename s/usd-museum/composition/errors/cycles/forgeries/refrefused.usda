#usda 1.0
(
    defaultPrim = "cycles"
    doc = "Forgery refrefused on piece refcycle: the reference refused for the cycle below it: no vase, no tag. This is what a viewer with that bug shows; the correct exhibit is ../cycles.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../cycles.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "cycles"
{
    over "Pieces"
    {
        over "refcycle"
        {
            over "Case" (
                kind = ""
            )
            {
                over "Looks" (
                    active = false
                )
                {
                }

                over "Tag" (
                    active = false
                )
                {
                }

                over "Loop" (
                    active = false
                )
                {
                }

                over "Vase" (
                    active = false
                )
                {
                }
            }
        }
    }
}

