#usda 1.0
(
    "hall relocate_payload: the rig whose CaseSrc strength.usda relocates onto Case."
    defaultPrim = "Cell"
)

over "Cell"
{
    over "CaseSrc"
    {
        color3f[] primvars:displayColor = [(0.010329823, 0.31398872, 0.08021982)] (
            interpolation = "constant"
        )
    }
}

