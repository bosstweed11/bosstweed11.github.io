#usda 1.0
(
    "hall nested: nest_a's own sublayer (ranks second)."
    defaultPrim = "Details"
)

over "Details"
{
    over "Cells"
    {
        over "nested"
        {
            over "Case"
            {
                color3f[] primvars:displayColor = [(0.91309863, 0.22322796, 0.030713445)] (
                    interpolation = "constant"
                )
            }
        }
    }
}

