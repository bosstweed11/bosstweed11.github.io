#usda 1.0
(
    "composition.strength.strength: which arc wins, the 21 pairs on a stepped installation. Each cell's Case gets primvars:displayColor from exactly its two arcs; its base is the color that should win. Referenced by exhibit.usda."
    defaultPrim = "Strength"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
    relocates = {
        </Strength/Cells/local_relocate/CaseSrc>: </Strength/Cells/local_relocate/Case>, 
        </Strength/Cells/inherit_relocate/CaseSrc>: </Strength/Cells/inherit_relocate/Case>, 
        </Strength/Cells/variant_relocate/CaseSrc>: </Strength/Cells/variant_relocate/Case>, 
        </Strength/Cells/relocate_reference/CaseSrc>: </Strength/Cells/relocate_reference/Case>, 
        </Strength/Cells/relocate_payload/CaseSrc>: </Strength/Cells/relocate_payload/Case>, 
        </Strength/Cells/relocate_specialize/CaseSrc>: </Strength/Cells/relocate_specialize/Case>
    }
)

