#usda 1.0
(
    "composition.strength.strength: the order details, five fights on a bench, each Case's primvars:displayColor from its two opinions; bases in the winner's color. Referenced by exhibit.usda."
    defaultPrim = "Details"
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @./arcs/nest_a.usda@,
        @./arcs/nest_b.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

