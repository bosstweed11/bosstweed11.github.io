#usda 1.0
(
    defaultPrim = "transforms"
    doc = "Forgery pivot on piece pivot: !invert! pivot ignored: the lever off its fulcrum, balls off their arcs. This is what a viewer with that bug shows; the correct exhibit is ../transforms.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 241
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../transforms.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "transforms"
{
    over "Pieces"
    {
        over "Pivot"
        {
            over "Lever"
            {
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:translate:pivot", "xformOp:rotateZ"]
            }
        }
    }
}

