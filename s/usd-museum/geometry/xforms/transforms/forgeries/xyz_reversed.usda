#usda 1.0
(
    defaultPrim = "transforms"
    doc = "Forgery xyz_reversed on piece rotateXYZ: rotation order reversed: the XYZ gizmo's balls out of their rings. This is what a viewer with that bug shows; the correct exhibit is ../transforms.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 241
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../transforms.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "transforms"
{
    over "Pieces"
    {
        over "XYZ"
        {
            over "Gizmo"
            {
                float xformOp:rotateXYZ = None
                float3 xformOp:rotateZYX = (90, 30, 30)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZYX"]
            }
        }
    }
}

