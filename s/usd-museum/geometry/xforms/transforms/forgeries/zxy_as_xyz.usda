#usda 1.0
(
    defaultPrim = "transforms"
    doc = "Forgery zxy_as_xyz on piece rotateZXY: rotateZXY read as XYZ: the second gizmo copies the first, its rings empty. This is what a viewer with that bug shows; the correct exhibit is ../transforms.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 241
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../transforms.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "transforms"
{
    over "Pieces"
    {
        over "ZXY"
        {
            over "Gizmo"
            {
                float3 xformOp:rotateXYZ = (90, 30, 30)
                float xformOp:rotateZXY = None
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
            }
        }
    }
}

