#usda 1.0
(
    defaultPrim = "transforms"
    doc = "Forgery op_order on piece op-order: xformOpOrder reversed: the paddle sheared and off its post. This is what a viewer with that bug shows; the correct exhibit is ../transforms.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 241
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../transforms.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "transforms"
{
    over "Pieces"
    {
        over "Order"
        {
            over "Paddle"
            {
                uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:rotateZ", "xformOp:translate"]
            }
        }
    }
}

