#usda 1.0
(
    defaultPrim = "transforms"
    doc = "Forgery orient_xyzw on piece orient: quaternion read xyzw: the third gizmo turned wrong. This is what a viewer with that bug shows; the correct exhibit is ../transforms.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 241
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../transforms.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "transforms"
{
    over "Pieces"
    {
        over "Orient"
        {
            over "Gizmo"
            {
                quatf xformOp:orient = (0.26294488, 0.7933533, 0.15776694, 0.52588975)
            }
        }
    }
}

