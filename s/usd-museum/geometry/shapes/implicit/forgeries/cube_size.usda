#usda 1.0
(
    defaultPrim = "implicit"
    doc = "Forgery cube_size on piece cube: size read as half width: the cube bursts its ghost. This is what a viewer with that bug shows; the correct exhibit is ../implicit.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../implicit.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "implicit"
{
    over "Pieces"
    {
        over "Cube"
        {
            over "Shape"
            {
                double size = 0.8
            }
        }
    }
}

