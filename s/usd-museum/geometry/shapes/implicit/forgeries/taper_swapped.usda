#usda 1.0
(
    defaultPrim = "implicit"
    doc = "Forgery taper_swapped on piece tapered: radiusTop and radiusBottom swapped: wide end up. This is what a viewer with that bug shows; the correct exhibit is ../implicit.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../implicit.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "implicit"
{
    over "Pieces"
    {
        over "Cylinder_1"
        {
            over "Shape"
            {
                double radiusBottom = 0.07
                double radiusTop = 0.2
            }
        }
    }
}

