#usda 1.0
(
    defaultPrim = "implicit"
    doc = "Forgery capsule_caps on piece capsule: caps added to height: the capsule pokes out of its ghost. This is what a viewer with that bug shows; the correct exhibit is ../implicit.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../implicit.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "implicit"
{
    over "Pieces"
    {
        over "Capsule"
        {
            over "Shape"
            {
                double height = 0.44
            }
        }
    }
}

