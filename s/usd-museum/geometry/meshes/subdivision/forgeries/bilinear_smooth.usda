#usda 1.0
(
    defaultPrim = "subdivision"
    doc = "Forgery bilinear_smooth on piece bilinear: bilinear read as catmullClark: smooth beside a faceted twin. This is what a viewer with that bug shows; the correct exhibit is ../subdivision.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../subdivision.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "subdivision"
{
    over "Pieces"
    {
        over "Bilinear"
        {
            over "Live"
            {
                over "Body"
                {
                    over "Rock"
                    {
                        uniform token subdivisionScheme = "catmullClark"
                    }
                }
            }
        }
    }
}

