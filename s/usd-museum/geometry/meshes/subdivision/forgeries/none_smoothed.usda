#usda 1.0
(
    defaultPrim = "subdivision"
    doc = "Forgery none_smoothed on piece none: none subdivided anyway: the cage rock rounded. This is what a viewer with that bug shows; the correct exhibit is ../subdivision.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../subdivision.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "subdivision"
{
    over "Pieces"
    {
        over "None"
        {
            over "Live"
            {
                over "Body"
                {
                    over "Rock"
                    {
                        uniform token subdivisionScheme = "catmullClark"
                    }
                }
            }
        }
    }
}

