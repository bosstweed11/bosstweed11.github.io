#usda 1.0
(
    defaultPrim = "meshes"
    doc = "Forgery handed on piece handedness: leftHanded ignored: the live box dark, inside out. This is what a viewer with that bug shows; the correct exhibit is ../meshes.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../meshes.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "meshes"
{
    over "Pieces"
    {
        over "Handed"
        {
            over "Live"
            {
                over "Box"
                {
                    uniform token orientation = "rightHanded"
                }
            }
        }
    }
}

