#usda 1.0
(
    defaultPrim = "meshes"
    doc = "Forgery doublesided on piece sidedness: doubleSided ignored: the back leaf black. This is what a viewer with that bug shows; the correct exhibit is ../meshes.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../meshes.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "meshes"
{
    over "Pieces"
    {
        over "Leaves"
        {
            over "Front"
            {
                over "Leaf"
                {
                    uniform bool doubleSided = 0
                }
            }

            over "Back"
            {
                over "Leaf"
                {
                    uniform bool doubleSided = 0
                }
            }
        }
    }
}

