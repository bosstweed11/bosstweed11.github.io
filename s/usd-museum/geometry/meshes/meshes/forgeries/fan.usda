#usda 1.0
(
    defaultPrim = "meshes"
    doc = "Forgery fan on piece concave: concave face fanned from the wrong corner: the notch filled over its red outline. This is what a viewer with that bug shows; the correct exhibit is ../meshes.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../meshes.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "meshes"
{
    over "Pieces"
    {
        over "Notch"
        {
            over "Tile"
            {
                over "Face"
                {
                    int[] faceVertexIndices = [1, 2, 3, 4, 0]
                }
            }
        }
    }
}

