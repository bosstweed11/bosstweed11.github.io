#usda 1.0
(
    defaultPrim = "meshes"
    doc = "Forgery normals on piece normals: authored normals ignored: the live pot faceted beside its smooth reference. This is what a viewer with that bug shows; the correct exhibit is ../meshes.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../meshes.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "meshes"
{
    over "Pieces"
    {
        over "Normals"
        {
            over "Live"
            {
                over "Pot"
                {
                    normal3f[] normals = None (
                        interpolation = "faceVarying"
                    )
                }
            }
        }
    }
}

