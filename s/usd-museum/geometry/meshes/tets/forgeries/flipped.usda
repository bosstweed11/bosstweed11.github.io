#usda 1.0
(
    defaultPrim = "tets"
    doc = "Forgery flipped on piece jelly: surface winding flipped: the jelly and gem dark, inside out. This is what a viewer with that bug shows; the correct exhibit is ../tets.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../tets.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "tets"
{
    over "Pieces"
    {
        over "Jelly"
        {
            over "Body"
            {
                over "Mound"
                {
                    uniform token orientation = "leftHanded"
                }

                over "Gem"
                {
                    uniform token orientation = "leftHanded"
                }
            }
        }
    }
}

