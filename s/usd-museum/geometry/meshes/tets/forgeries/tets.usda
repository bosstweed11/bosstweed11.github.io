#usda 1.0
(
    defaultPrim = "tets"
    doc = "Forgery tets on piece jelly: TetMesh unsupported: an empty ghost, no gem. This is what a viewer with that bug shows; the correct exhibit is ../tets.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../tets.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "tets"
{
    over "Pieces"
    {
        over "Jelly"
        {
            over "Body"
            {
                over TetMesh_9 "Mound"
                {
                    float doubleSided = None
                    float orientation = None
                    float purpose = None
                    float visibility = None
                }

                over TetMesh_9 "Gem"
                {
                    float doubleSided = None
                    float orientation = None
                    float purpose = None
                    float visibility = None
                }
            }
        }
    }
}

