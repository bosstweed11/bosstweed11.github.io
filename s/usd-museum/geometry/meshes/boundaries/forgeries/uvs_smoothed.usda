#usda 1.0
(
    defaultPrim = "boundaries"
    doc = "Forgery uvs_smoothed on piece uvs: all read as none: the checker's kinks smoothed. This is what a viewer with that bug shows; the correct exhibit is ../boundaries.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../boundaries.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "boundaries"
{
    over "Pieces"
    {
        over "UVs"
        {
            over "Live"
            {
                over "Panel"
                {
                    token faceVaryingLinearInterpolation = "none"
                }
            }
        }
    }
}

