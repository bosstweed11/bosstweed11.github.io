#usda 1.0
(
    defaultPrim = "boundaries"
    doc = "Forgery boundary_drawn on piece none: none ignored: the whole panel beside a small twin. This is what a viewer with that bug shows; the correct exhibit is ../boundaries.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../boundaries.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "boundaries"
{
    over "Pieces"
    {
        over "NoBoundary"
        {
            over "Live"
            {
                over "Panel"
                {
                    token interpolateBoundary = "edgeAndCorner"
                }
            }
        }
    }
}

