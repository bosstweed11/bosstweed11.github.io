#usda 1.0
(
    defaultPrim = "boundaries"
    doc = "Forgery corners_rounded on piece edgeAndCorner: edgeAndCorner read as edgeOnly: rounded corners. This is what a viewer with that bug shows; the correct exhibit is ../boundaries.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../boundaries.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "boundaries"
{
    over "Pieces"
    {
        over "Corners"
        {
            over "Live"
            {
                over "Panel"
                {
                    token interpolateBoundary = "edgeOnly"
                }
            }
        }
    }
}

