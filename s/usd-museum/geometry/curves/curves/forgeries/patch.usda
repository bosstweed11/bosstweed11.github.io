#usda 1.0
(
    defaultPrim = "curves"
    doc = "Forgery patch on piece nurbs: NurbsPatch not drawn: an empty frame. This is what a viewer with that bug shows; the correct exhibit is ../curves.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
