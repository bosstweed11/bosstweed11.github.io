#usda 1.0
(
    defaultPrim = "curves"
    doc = "Forgery wrap on piece periodic: periodic ignored: a gap in the ring. This is what a viewer with that bug shows; the correct exhibit is ../curves.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../curves.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "curves"
{
    over "Pieces"
    {
        over "Ring"
        {
            over "Trellis"
            {
                over "Vine"
                {
                    uniform token wrap = "nonperiodic"
                }
            }
        }
    }
}

