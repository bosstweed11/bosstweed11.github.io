#usda 1.0
(
    defaultPrim = "curves"
    doc = "Forgery widths on piece vertex-widths: vertex widths ignored: hairline blades in empty outlines. This is what a viewer with that bug shows; the correct exhibit is ../curves.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../curves.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "curves"
{
    over "Pieces"
    {
        over "Blades"
        {
            over "Tuft"
            {
                over "Blade0"
                {
                    float[] widths = [0.006] (
                        interpolation = "constant"
                    )
                }

                over "Blade1"
                {
                    float[] widths = [0.006] (
                        interpolation = "constant"
                    )
                }

                over "Blade2"
                {
                    float[] widths = [0.006] (
                        interpolation = "constant"
                    )
                }
            }
        }
    }
}

