#usda 1.0
(
    defaultPrim = "curves"
    doc = "Exhibit geometry.curves.curves: Curves and NURBS. Look for: every blade fills its outline, every disc its ring; the ring and tendril cover their guides peg to peg; the cushion fills its frame; the red box stays empty. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "curves" (
    prepend apiSchemas = ["AuthorshipAPI:claude", "AuthorshipAPI:build", "AssetPreviewsAPI"]
    assetInfo = {
        asset identifier = @./curves.usda@
        string name = "curves"
        dictionary previews = {
            dictionary thumbnails = {
                dictionary default = {
                    asset defaultImage = @./thumbnail.jpg@
                }
            }
        }
    }
    customData = {
        dictionary museum = {
            string[] belt = ["10.Grass", "10.Nurbs"]
            string id = "geometry.curves.curves"
            string look_for = "every blade fills its outline, every disc its ring; the ring and tendril cover their guides peg to peg; the cushion fills its frame; the red box stays empty"
            string[] spec = ["usdGeom#basiscurves", "usdGeom#points", "usdGeom#nurbspatch", "usdGeom#hermitecurves"]
            string title = "Curves and NURBS"
            string wg = "geometry"
        }
    }
    kind = "assembly"
    prepend payload = @./payload.usda@
)
{
    uniform string authorship:build:created = "2026-11-12T01:22:45-08:00"
    uniform string[] authorship:build:creator = ["usd-tour museum/src/export.py"]
    uniform string authorship:build:description = "Written through OpenUSD's Python API by usd-tour's build and export scripts (written by Claude Opus 5.5)."
    uniform string authorship:build:digitalSourceType = "http://cv.iptc.org/newscodes/digitalsourcetype/algorithmicMedia"
