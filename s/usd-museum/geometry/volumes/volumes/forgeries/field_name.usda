#usda 1.0
(
    defaultPrim = "volumes"
    doc = "Forgery field_name on piece still: field name misread: no clouds, both red cards. This is what a viewer with that bug shows; the correct exhibit is ../volumes.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 96
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../volumes.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "volumes"
{
    over "Pieces"
    {
        over "Still"
        {
            over "Cloud"
            {
                over "Density"
                {
                    token fieldName = "Density"
                }

                over "Emission"
                {
                    token fieldName = "Emission"
                }
            }
        }

        over "Sequence"
        {
            over "Cloud"
            {
                over "Density"
                {
                    token fieldName = "Density"
                }

                over "Emission"
                {
                    token fieldName = "Emission"
                }
            }
        }
    }
}

