#usda 1.0
(
    defaultPrim = "spaces"
    doc = "Forgery default_srgb on piece default: default color space taken as sRGB: a dark default vase. This is what a viewer with that bug shows; the correct exhibit is ../spaces.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../spaces.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "spaces"
{
    over "Pieces"
    {
        over "Plain" (
            apiSchemas = ["ColorSpaceAPI"]
        )
        {
            uniform token colorSpace:name = "srgb_rec709_scene"
        }
    }
}

