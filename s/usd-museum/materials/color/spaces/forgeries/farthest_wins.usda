#usda 1.0
(
    defaultPrim = "spaces"
    doc = "Forgery farthest_wins on piece nearest: farthest ancestor wins: the nearest vase off its base. This is what a viewer with that bug shows; the correct exhibit is ../spaces.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../spaces.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "spaces"
{
    over "Pieces"
    {
        over "Root"
        {
            over "Nearest"
            {
                over "Looks"
                {
                    over "Value"
                    {
                        uniform token colorSpace:name = "srgb_rec709_scene"
                    }
                }
            }
        }
    }
}

