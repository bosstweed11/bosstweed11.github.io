    def Scope "lighting" (
        doc = "The museum's light: a warm key and a cool fill distant light, always on (no lamps; Hydra Storm draws at most 16 lights)."
    )
    {
        def DistantLight "Key"
        {
            float inputs:angle = 20
            color3f inputs:color = (1, 0.93, 0.83)
            float inputs:intensity = 6
            matrix4d xformOp:transform = ( (0.9396926207859084, 0, -0.34202014332566877, 0), (-0.17101007166283436, 0.8660254037844387, -0.46984631039295416, 0), (0.2961981327260239, 0.49999999999999994, 0.8137976813493738, 0), (0, 0, 0, 1) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
