#usda 1.0
(
    defaultPrim = "materialx"
    doc = "Forgery nograph on piece marble: node-graph inputs not connected: no veins. This is what a viewer with that bug shows; the correct exhibit is ../materialx.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../materialx.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "materialx"
{
    over "Pieces"
    {
        over "marble"
        {
            over "Looks"
            {
                over "Marble"
                {
                    over "SR_marble_blue"
                    {
                        color3f inputs:base_color = (0.62, 0.62, 0.62)
                        color3f inputs:base_color.connect = None
                        color3f inputs:subsurface_color = (0.62, 0.62, 0.62)
                        color3f inputs:subsurface_color.connect = None
                    }
                }
            }
        }
    }
}

