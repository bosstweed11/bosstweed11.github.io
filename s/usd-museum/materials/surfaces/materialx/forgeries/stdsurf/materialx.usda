#usda 1.0
(
    defaultPrim = "materialx"
    doc = "Exhibit materials.surfaces.materialx: MaterialX. Look for: the balls match their prints (blue veins, copper); each tile pair matches its orange bar. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "materialx" (
    assetInfo = {
        asset identifier = @./materialx.usda@
        string name = "materialx"
    }
    customData = {
        dictionary museum = {
            string[] belt = ["11.Mtlx"]
            string id = "materials.surfaces.materialx"
            string look_for = "the balls match their prints (blue veins, copper); each tile pair matches its orange bar"
            string[] spec = ["color"]
            string title = "MaterialX"
            string wg = "materials"
        }
    }
    kind = "assembly"
    prepend payload = @./payload.usda@
)
{
    over "Pieces"
    {
        over "marble" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Mtlx/marble.mtlx"]
                    string[] features = ["SHADE-MTLX.files", "FILEFORMAT-PLUGINS", "SHADE-SDR.contexts"]
                    string[] forgeries = ["nomtlx", "mtlxlayer", "nograph"]
                    string reference = "its reference print"
                }
            }
            doc = "a ball bound to Blue_Marble from marble.mtlx (usdMtlx), green preview on the universal output"
        )
        {
        }

        over "coated" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Mtlx/mtlx before preview"]
                    string[] features = ["SHADE-MTLX.nodes"]
                    string[] forgeries = ["stdsurf"]
                    string reference = "its reference print"
                }
            }
            doc = "a ball with a USD-authored ND_standard_surface: copper under a clear coat"
        )
        {
        }

        over "source" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Mtlx/sourceColorSpace"]
                    string[] features = ["COLOR-SPACE.textures"]
                    string[] forgeries = ["rawsrgb"]
                    string reference = "the expected orange bar"
                }
            }
            doc = "sRGB and raw files through sourceColorSpace"
        )
        {
        }

        over "meta" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Mtlx/file colorSpace"]
                    string[] features = ["COLOR-SPACE.resolve"]
                    string[] forgeries = ["colorspace"]
                    string reference = "the expected orange bar"
                    string[] spec = ["color#colorspace-token"]
                }
            }
            doc = "the file's colorSpace metadata"
        )
        {
        }

        over "api" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Mtlx/ColorSpaceAPI"]
                    string[] features = ["COLOR-SPACE.resolve"]
                    string[] forgeries = ["colorspace"]
                    string reference = "the expected orange bar"
                    string[] spec = ["color#colorspaceapi"]
                }
            }
            doc = "ColorSpaceAPI on a MaterialX ND_UsdPreviewSurface material"
        )
        {
        }
    }
}

