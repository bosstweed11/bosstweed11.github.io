#usda 1.0
(
    defaultPrim = "materialx"
    doc = "Forgery colorspace on piece meta: color space ignored: the metadata tile dark, the API tile washed out. This is what a viewer with that bug shows; the correct exhibit is ../materialx.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../materialx.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "materialx"
{
    over "Pieces"
    {
        over "api"
        {
            over "Looks"
            {
                over "SRGB" (
                    apiSchemas = None
                )
                {
                    float colorSpace:name = None
                }
            }
        }
    }
}

