#usda 1.0
(
    defaultPrim = "materialx"
    doc = "Forgery rawsrgb on piece source: raw texture read as sRGB: the raw tile darker than its bar. This is what a viewer with that bug shows; the correct exhibit is ../materialx.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../materialx.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "materialx"
{
    over "Pieces"
    {
        over "source"
        {
            over "Looks"
            {
                over "Raw"
                {
                    over "Tex"
                    {
                        float inputs:sourceColorSpace = None
                    }
                }
            }
        }
    }
}

