#usda 1.0
(
    defaultPrim = "materialx"
    doc = "Exhibit materials.surfaces.materialx: MaterialX. Look for: the balls match their prints (blue veins, copper); each tile pair matches its orange bar. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "materialx" (
    prepend apiSchemas = ["AuthorshipAPI:claude", "AuthorshipAPI:build", "AssetPreviewsAPI"]
    assetInfo = {
        asset identifier = @./materialx.usda@
        string name = "materialx"
        dictionary previews = {
            dictionary thumbnails = {
                dictionary default = {
                    asset defaultImage = @./thumbnail.jpg@
                }
            }
        }
    }
    customData = {
        dictionary museum = {
            string[] belt = ["11.Mtlx"]
            string id = "materials.surfaces.materialx"
            string look_for = "the balls match their prints (blue veins, copper); each tile pair matches its orange bar"
            string[] spec = ["color"]
            string title = "MaterialX"
            string wg = "materials"
        }
    }
    kind = "assembly"
    prepend payload = @./payload.usda@
)
{
    uniform string authorship:build:created = "2026-11-13T20:04:05-08:00"
    uniform string[] authorship:build:creator = ["usd-tour museum/src/export.py"]
    uniform string authorship:build:description = "Written through OpenUSD's Python API by usd-tour's build and export scripts (written by Claude Opus 5.5)."
    uniform string authorship:build:digitalSourceType = "http://cv.iptc.org/newscodes/digitalsourcetype/algorithmicMedia"
    uniform string[] authorship:build:inputs = ["source", "usd-tour 5103439"]
    uniform string authorship:build:softwarePackage = "OpenUSD"
    uniform string authorship:build:softwareVersion = "26.11"
    uniform string authorship:build:usageTerms = "CC0-1.0"
    uniform string authorship:claude:created = "2026-11-13T20:04:05-08:00"
    uniform string[] authorship:claude:creator = ["Claude Opus 5.5 (Anthropic)"]
    uniform string authorship:claude:description = "Claude Opus 5.5, working in Claude Code, built every prim in this museum: it designed the exhibits and wrote the usd-tour scripts that author them."
    uniform string authorship:claude:digitalSourceType = "http://cv.iptc.org/newscodes/digitalsourcetype/trainedAlgorithmicMedia"
    uniform string[] authorship:claude:inputs = ["source", "usd-tour 5103439"]
    uniform string authorship:claude:softwarePackage = "com.anthropic.claude"
    uniform string authorship:claude:softwareVersion = "claude-opus-5-5"
    uniform string authorship:claude:usageTerms = "CC0-1.0"
    float3[] extentsHint = [(-2.7, 0, -1.5), (2.7, 2.5, -0.46655205)]

    over "Pieces"
    {
        over "marble" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Mtlx/marble.mtlx"]
                    string[] features = ["SHADE-MTLX.files", "FILEFORMAT-PLUGINS", "SHADE-SDR.contexts"]
                    string[] forgeries = ["nomtlx", "mtlxlayer", "nograph"]
                    string reference = "its reference print"
                }
            }
            doc = "a ball bound to Blue_Marble from marble.mtlx (usdMtlx), green preview on the universal output"
        )
        {
        }

        over "coated" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Mtlx/mtlx before preview"]
                    string[] features = ["SHADE-MTLX.nodes"]
                    string[] forgeries = ["stdsurf"]
                    string reference = "its reference print"
                }
            }
            doc = "a ball with a USD-authored ND_standard_surface: copper under a clear coat"
        )
        {
        }

        over "source" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Mtlx/sourceColorSpace"]
                    string[] features = ["COLOR-SPACE.textures"]
                    string[] forgeries = ["rawsrgb"]
                    string reference = "the expected orange bar"
                }
            }
            doc = "sRGB and raw files through sourceColorSpace"
        )
        {
        }

        over "meta" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Mtlx/file colorSpace"]
                    string[] features = ["COLOR-SPACE.resolve"]
                    string[] forgeries = ["colorspace"]
                    string reference = "the expected orange bar"
                    string[] spec = ["color#colorspace-token"]
                }
            }
            doc = "the file's colorSpace metadata"
        )
        {
        }

        over "api" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Mtlx/ColorSpaceAPI"]
                    string[] features = ["COLOR-SPACE.resolve"]
                    string[] forgeries = ["colorspace"]
                    string reference = "the expected orange bar"
                    string[] spec = ["color#colorspaceapi"]
                }
            }
            doc = "ColorSpaceAPI on a MaterialX ND_UsdPreviewSurface material"
        )
        {
        }
    }
}

