-- glslfx version 0.1
-- configuration
{
    "parameters" : { "paint" : { "default" : [1.0, 1.0, 1.0], "type" : "vec3" } },
    "techniques" : { "default" : { "surfaceShader" : { "source" : [ "Museum.Flat" ] } } }
}
-- glsl Museum.Flat
vec4
surfaceShader(vec4 Peye, vec3 Neye, vec4 color, vec4 patchCoord)
{
    return vec4(HdGet_paint().xyz, 1.0);
}
