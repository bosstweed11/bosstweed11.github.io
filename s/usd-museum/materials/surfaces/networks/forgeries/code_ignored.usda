#usda 1.0
(
    defaultPrim = "networks"
    doc = "Forgery code_ignored on piece code: the inline glslfx not read: a grey ball on magenta. This is what a viewer with that bug shows; the correct exhibit is ../networks.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../networks.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "networks"
{
    over "Pieces"
    {
        over "code"
        {
            over "Looks"
            {
                over "Flat"
                {
                    over "Flat"
                    {
                        float info:glslfx:sourceCode = None
                        uniform token info:implementationSource = "id"
                    }
                }
            }
        }
    }
}

