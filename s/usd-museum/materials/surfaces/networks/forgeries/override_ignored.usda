#usda 1.0
(
    defaultPrim = "networks"
    doc = "Forgery override_ignored on piece override: the override ignored: an orange ball on blue. This is what a viewer with that bug shows; the correct exhibit is ../networks.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../networks.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "networks"
{
    over "Pieces"
    {
        over "override"
        {
            over "Looks"
            {
                over "Blue"
                {
                    color3f inputs:tint = (0.85, 0.36, 0.06)
                }
            }
        }
    }
}

