#usda 1.0
(
    defaultPrim = "networks"
    doc = "Forgery asset_ignored on piece asset: the glslfx file not read: a grey ball on green. This is what a viewer with that bug shows; the correct exhibit is ../networks.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../networks.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "networks"
{
    over "Pieces"
    {
        over "asset"
        {
            over "Looks"
            {
                over "Flat"
                {
                    over "Flat"
                    {
                        float info:glslfx:sourceAsset = None
                        uniform token info:implementationSource = "id"
                    }
                }
            }
        }
    }
}

