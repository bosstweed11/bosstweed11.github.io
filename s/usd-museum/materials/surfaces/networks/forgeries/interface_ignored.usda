#usda 1.0
(
    defaultPrim = "networks"
    doc = "Forgery interface_ignored on piece graph: the interface input not followed: a black ball on orange. This is what a viewer with that bug shows; the correct exhibit is ../networks.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../networks.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "networks"
{
    over "Pieces"
    {
        over "graph"
        {
            over "Looks"
            {
                over "Painted"
                {
                    over "Paint"
                    {
                        color3f inputs:color = None
                        color3f inputs:color.connect = None
                    }
                }
            }
        }

        over "override"
        {
            over "Looks"
            {
                over "Blue"
                {
                    over "Paint"
                    {
                        color3f inputs:color = None
                        color3f inputs:color.connect = None
                    }
                }
            }
        }
    }
}

