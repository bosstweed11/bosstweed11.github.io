#usda 1.0
(
    defaultPrim = "preview"
    doc = "Forgery metallic on piece metallic: metallic ignored: a yellow plastic ball. This is what a viewer with that bug shows; the correct exhibit is ../preview.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../preview.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "preview"
{
    over "Pieces"
    {
        over "metallic"
        {
            over "Looks"
            {
                over "Gold"
                {
                    over "Surface"
                    {
                        float inputs:metallic = None
                    }
                }
            }
        }
    }
}

