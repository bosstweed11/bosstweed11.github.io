#usda 1.0
(
    defaultPrim = "preview"
    doc = "Forgery opacity on piece opacity: opacity ignored: an opaque blue ball hides the stripes. This is what a viewer with that bug shows; the correct exhibit is ../preview.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../preview.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "preview"
{
    over "Pieces"
    {
        over "opacity"
        {
            over "Looks"
            {
                over "Glass"
                {
                    over "Surface"
                    {
                        float inputs:opacity = None
                    }
                }
            }
        }
    }
}

