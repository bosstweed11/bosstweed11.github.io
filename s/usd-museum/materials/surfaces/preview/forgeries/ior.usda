#usda 1.0
(
    defaultPrim = "preview"
    doc = "Forgery ior on piece ior: ior ignored (1.5): a dull black ball, no sheen. This is what a viewer with that bug shows; the correct exhibit is ../preview.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../preview.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "preview"
{
    over "Pieces"
    {
        over "ior"
        {
            over "Looks"
            {
                over "Glaze"
                {
                    over "Surface"
                    {
                        float inputs:ior = None
                    }
                }
            }
        }
    }
}

