#usda 1.0
(
    defaultPrim = "preview"
    doc = "Exhibit materials.surfaces.preview: UsdPreviewSurface. Look for: each ball matches the reference print above it. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "preview" (
    assetInfo = {
        asset identifier = @./preview.usda@
        string name = "preview"
    }
    customData = {
        dictionary museum = {
            string[] belt = ["11.Preview"]
            string id = "materials.surfaces.preview"
            string look_for = "each ball matches the reference print above it"
            string title = "UsdPreviewSurface"
            string wg = "materials"
        }
    }
    kind = "assembly"
    prepend payload = @./payload.usda@
)
{
    over "Pieces"
    {
        over "metallic" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Preview/brushed steel"]
                    string[] features = ["SHADE-PREVIEW.surface"]
                    string[] forgeries = ["metallic"]
                    string reference = "its reference print"
                }
            }
            doc = "a gold ball: metallic 1, roughness 0.3"
        )
        {
        }

        over "roughness" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Preview/brushed steel"]
                    string[] features = ["SHADE-PREVIEW.surface"]
                    string[] forgeries = ["roughness"]
                    string reference = "its reference print"
                }
            }
            doc = "a steel ball whose roughness texture makes mirror and matte bands"
        )
        {
        }

        over "emissive" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Preview/orange glow"]
                    string[] features = ["SHADE-PREVIEW.surface"]
                    string[] forgeries = ["emissive"]
                    string reference = "its reference print"
                }
            }
            doc = "a lamp ball: emissiveColor orange over a red diffuse"
        )
        {
        }

        over "opacity" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Preview/stripes through blue glass"]
                    string[] features = ["SHADE-PREVIEW.surface"]
                    string[] forgeries = ["opacity"]
                    string reference = "its reference print"
                }
            }
            doc = "blue glass (opacity 0.3) in front of a striped card"
        )
        {
        }

        over "ior" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Preview/stripes through blue glass"]
                    string[] features = ["SHADE-PREVIEW.surface"]
                    string[] forgeries = ["ior"]
                    string reference = "its reference print"
                }
            }
            doc = "a black glaze with ior 5.0 (F0 0.44): a bright sheen"
        )
        {
        }
    }
}

