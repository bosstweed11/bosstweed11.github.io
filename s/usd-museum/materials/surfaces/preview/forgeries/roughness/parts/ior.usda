#usda 1.0
(
    "materials.surfaces.preview: the ior ball. Referenced by exhibit.usda."
    defaultPrim = "Ior"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Ior" (
    kind = "component"
)
{
    def Scope "Looks"
    {
        def Material "Ring"
        {
            token outputs:surface.connect = </Ior/Looks/Ring/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.11)
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "Glaze"
        {
            token outputs:surface.connect = </Ior/Looks/Glaze/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015, 0.015, 0.02)
                float inputs:ior = 5
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }
    }

    def Xform "Ball" (
        prepend references = @./ball.usda@
    )
    {
        float3 xformOp:scale = (0.26291078, 0.26291078, 0.26291078)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

        over "Sphere"
        {
            over "Body" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Ior/Looks/Glaze>
            }

            over "Ring" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Ior/Looks/Ring>
            }
        }

        def Material "BaseLook"
        {
            token outputs:surface.connect = </Ior/Ball/BaseLook/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.09)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        over "Base" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Ior/Ball/BaseLook>
        }
    }
}

