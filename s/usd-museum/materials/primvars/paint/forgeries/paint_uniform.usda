#usda 1.0
(
    defaultPrim = "paint"
    doc = "Forgery paint_uniform on piece interpolation: uniform read as constant: one-color uniform panels. This is what a viewer with that bug shows; the correct exhibit is ../paint.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../paint.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "paint"
{
    over "Pieces"
    {
        over "rack"
        {
            over "Lean"
            {
                over "Plain"
                {
                    over "Uniform"
                    {
                        color3f[] primvars:displayColor = [(0.9, 0.15, 0.15)] (
                            interpolation = "constant"
                        )
                    }
                }

                over "Indexed"
                {
                    over "Uniform"
                    {
                        color3f[] primvars:displayColor = [(0.9, 0.15, 0.15)] (
                            interpolation = "constant"
                        )
                        float primvars:displayColor:indices = None
                    }
                }
            }
        }
    }
}

