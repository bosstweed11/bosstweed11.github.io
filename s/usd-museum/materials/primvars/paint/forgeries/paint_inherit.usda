#usda 1.0
(
    defaultPrim = "paint"
    doc = "Forgery paint_inherit on piece brushes: constant primvar not inherited: grey brushes over colored dabs. This is what a viewer with that bug shows; the correct exhibit is ../paint.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../paint.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "paint"
{
    over "Pieces"
    {
        over "brushes"
        {
            over "Brush0"
            {
                float primvars:displayColor = None
            }

            over "Brush1"
            {
                float primvars:displayColor = None
            }

            over "Brush2"
            {
                float primvars:displayColor = None
            }
        }
    }
}

