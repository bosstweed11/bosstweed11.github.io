#usda 1.0
(
    defaultPrim = "paint"
    doc = "Forgery paint_grey on piece interpolation: displayColor ignored: every live panel grey under its printed card. This is what a viewer with that bug shows; the correct exhibit is ../paint.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../paint.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "paint"
{
    over "Pieces"
    {
        over "rack"
        {
            over "Lean"
            {
                over "Plain"
                {
                    over "Constant"
                    {
                        color3f[] primvars:displayColor = None
                    }

                    over "Uniform"
                    {
                        color3f[] primvars:displayColor = None
                    }

                    over "Vertex"
                    {
                        color3f[] primvars:displayColor = None
                    }

                    over "Varying"
                    {
                        color3f[] primvars:displayColor = None
                    }

                    over "FaceVarying"
                    {
                        color3f[] primvars:displayColor = None
                    }
                }

                over "Indexed"
                {
                    over "Constant"
                    {
                        color3f[] primvars:displayColor = None
                        float primvars:displayColor:indices = None
                    }

                    over "Uniform"
                    {
                        color3f[] primvars:displayColor = None
                        float primvars:displayColor:indices = None
                    }

                    over "Vertex"
                    {
                        color3f[] primvars:displayColor = None
                        float primvars:displayColor:indices = None
                    }

                    over "Varying"
                    {
                        color3f[] primvars:displayColor = None
                        float primvars:displayColor:indices = None
                    }

                    over "FaceVarying"
                    {
                        color3f[] primvars:displayColor = None
                        float primvars:displayColor:indices = None
                    }
                }
            }
        }
    }
}

