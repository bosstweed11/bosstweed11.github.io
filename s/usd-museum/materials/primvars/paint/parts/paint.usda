            {
                token outputs:surface.connect = </Paint/Rack/Looks/Rack/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.1, 0.1, 0.11)
                    float inputs:roughness = 0.8
                    token outputs:surface
                }
            }

            def Material "Foot"
            {
                token outputs:surface.connect = </Paint/Rack/Looks/Foot/Surface.outputs:surface>

