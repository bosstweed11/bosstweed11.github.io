#usda 1.0
(
    "materials.primvars.paint: the paint rack (five interpolations x reference, plain, indexed) and three brushes inheriting their parent's constant displayColor."
    defaultPrim = "Paint"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Paint" (
    kind = "group"
)
{
    def Scope "Looks"
    {
    }

    def Xform "Rack"
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Scope "Looks"
        {
