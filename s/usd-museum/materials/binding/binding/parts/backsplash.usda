#usda 1.0
(
    "materials.binding.binding: one mesh of 65 tiles, three materialBind geom subsets (partition, face indices): black bottom row, blue zig-zags, white. The key card is drawn from the same lists."
    defaultPrim = "Backsplash"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Backsplash" (
    kind = "component"
)
{
    def Scope "Looks"
    {
        def Material "Grout"
        {
            token outputs:surface.connect = </Backsplash/Looks/Grout/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.55, 0.52)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "White"
        {
            token outputs:surface.connect = </Backsplash/Looks/White/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.93, 0.9)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Blue"
        {
            token outputs:surface.connect = </Backsplash/Looks/Blue/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.3, 0.8)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Black"
        {
            token outputs:surface.connect = </Backsplash/Looks/Black/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.03, 0.03)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Stand"
        {
            token outputs:surface.connect = </Backsplash/Looks/Stand/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.12, 0.13)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Key"
        {
            token outputs:surface.connect = </Backsplash/Looks/Key/Surface.outputs:surface>

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:fallback = (1, 0, 1, 1)
                asset inputs:file = @./textures/key.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Backsplash/Looks/Key/St.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor.connect = </Backsplash/Looks/Key/Tex.outputs:rgb>
                float inputs:roughness = 1
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

    def Mesh "Board" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
