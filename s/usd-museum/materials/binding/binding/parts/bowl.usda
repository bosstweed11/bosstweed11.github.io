#usda 1.0
(
    "materials.binding.binding: /Bowl binds orange to its collection 'fruit' (includes ./Fruit, expandPrims) strongerThanDescendants; Fruit/Apple2 binds red itself and is orange too. /Bowl/Control binds red outside the collection: red. The orange base and the red saucer are the answer key."
    defaultPrim = "Bowl"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Bowl" (
    prepend apiSchemas = ["CollectionAPI:fruit", "MaterialBindingAPI"]
    kind = "component"
)
{
    uniform token collection:fruit:expansionRule = "expandPrims"
    prepend rel collection:fruit:includes = </Bowl/Group/Fruit>
    rel material:binding:collection:fruit = [
        </Bowl.collection:fruit>,
        </Bowl/Looks/Orange>,
    ] (
        bindMaterialAs = "strongerThanDescendants"
    )

    def Scope "Looks"
    {
        def Material "Red"
        {
            token outputs:surface.connect = </Bowl/Looks/Red/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.08, 0.06)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "Orange"
        {
            token outputs:surface.connect = </Bowl/Looks/Orange/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.45, 0.02)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "Dish"
        {
            token outputs:surface.connect = </Bowl/Looks/Dish/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.92, 0.9)
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

