#usda 1.0
(
    defaultPrim = "binding"
    doc = "Exhibit materials.binding.binding: Which material binds. Look for: every jar matches its coaster, every fruit its base, the tiles the key. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "binding" (
    prepend apiSchemas = ["AuthorshipAPI:claude", "AuthorshipAPI:build", "AssetPreviewsAPI"]
    assetInfo = {
        asset identifier = @./binding.usda@
        string name = "binding"
        dictionary previews = {
            dictionary thumbnails = {
                dictionary default = {
                    asset defaultImage = @./thumbnail.jpg@
                }
            }
        }
    }
    customData = {
        dictionary museum = {
            string[] belt = ["12.Shelves", "12.Bowl", "12.Backsplash"]
            string id = "materials.binding.binding"
            string look_for = "every jar matches its coaster, every fruit its base, the tiles the key"
            string[] spec = ["collections"]
            string title = "Which material binds"
            string wg = "materials"
        }
    }
    kind = "assembly"
    prepend payload = @./payload.usda@
)
{
    uniform string authorship:build:created = "2026-11-12T01:22:45-08:00"
    uniform string[] authorship:build:creator = ["usd-tour museum/src/export.py"]
    uniform string authorship:build:description = "Written through OpenUSD's Python API by usd-tour's build and export scripts (written by Claude Opus 5.5)."
    uniform string authorship:build:digitalSourceType = "http://cv.iptc.org/newscodes/digitalsourcetype/algorithmicMedia"
    uniform string[] authorship:build:inputs = ["source", "usd-tour 0072026"]
    uniform string authorship:build:softwarePackage = "OpenUSD"
    uniform string authorship:build:softwareVersion = "26.11"
    uniform string authorship:build:usageTerms = "CC0-1.0"
    uniform string authorship:claude:created = "2026-11-12T01:22:45-08:00"
    uniform string[] authorship:claude:creator = ["Claude Opus 5.5 (Anthropic)"]
    uniform string authorship:claude:description = "Claude Opus 5.5, working in Claude Code, built every prim in this museum: it designed the exhibits and wrote the usd-tour scripts that author them."
    uniform string authorship:claude:digitalSourceType = "http://cv.iptc.org/newscodes/digitalsourcetype/trainedAlgorithmicMedia"
    uniform string[] authorship:claude:inputs = ["source", "usd-tour 0072026"]
    uniform string authorship:claude:softwarePackage = "com.anthropic.claude"
    uniform string authorship:claude:softwareVersion = "claude-opus-5-5"
    uniform string authorship:claude:usageTerms = "CC0-1.0"

    over "Pieces"
    {
        over "green" (
            customData = {
                dictionary museum = {
                    string[] belt = ["12.Shelves/inherited", "12.Shelves/jar's own"]
                    string[] features = ["SHADE-BIND.inherit"]
                    string[] forgeries = ["not_inherited"]
                    string reference = "each jar's coaster in the color it must resolve to"
                }
            }
            doc = "the Jars group binds green; jar 2 binds red itself"
        )
        {
        }

        over "blue" (
            customData = {
                dictionary museum = {
                    string[] belt = ["12.Shelves/strongerThanDescendants", "12.Shelves/preview purpose"]
                    string[] features = ["SHADE-BIND.strength", "SHADE-BIND.purpose"]
                    string[] forgeries = ["strength", "purpose"]
                    string reference = "each jar's coaster"
                }
            }
            doc = "blue strongerThanDescendants over jar 2's red; jar 4 yellow for preview, WRONG for full"
        )
        {
        }

        over "bowl" (
            customData = {
                dictionary museum = {
                    string[] belt = ["12.Bowl/expandPrims include", "12.Bowl/strongerThanDescendants"]
                    string[] features = ["SHADE-COLLBIND"]
                    string[] forgeries = ["collection", "coll_strength"]
                    string reference = "the orange base under the bowl, the red saucer under the control"
                    string[] spec = ["collections#collectionapi"]
                }
            }
            doc = "a collection binding (expandPrims) strongerThanDescendants; a control apple"
        )
        {
        }

        over "backsplash" (
            customData = {
                dictionary museum = {
                    string[] belt = ["12.Backsplash/face indices", "12.Backsplash/materialBind family"]
                    string[] features = ["GEOM-SUBSET"]
                    string[] forgeries = ["no_subsets", "as_vertices"]
                    string reference = "the printed key beside it, drawn from the same face lists"
                }
            }
            doc = "one tile mesh, three materialBind geom subsets (partition)"
        )
        {
        }
    }
}

