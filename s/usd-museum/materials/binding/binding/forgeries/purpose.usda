#usda 1.0
(
    defaultPrim = "binding"
    doc = "Forgery purpose on piece blue: purpose ignored: a magenta WRONG jar on a yellow coaster. This is what a viewer with that bug shows; the correct exhibit is ../binding.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../binding.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "binding"
{
    over "Pieces"
    {
        over "blue"
        {
            over "Jars"
            {
                over "Jar4"
                {
                    custom rel material:binding:full = None
                    custom rel material:binding:preview = </binding/Pieces/blue/Looks/Wrong>
                }
            }
        }
    }
}

