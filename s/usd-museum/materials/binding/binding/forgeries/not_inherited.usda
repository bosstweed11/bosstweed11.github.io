#usda 1.0
(
    defaultPrim = "binding"
    doc = "Forgery not_inherited on piece green: binding not inherited: grey jars on colored coasters. This is what a viewer with that bug shows; the correct exhibit is ../binding.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../binding.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "binding"
{
    over "Pieces"
    {
        over "green"
        {
            over "Jars"
            {
                custom rel material:binding = None
            }
        }

        over "blue"
        {
            over "Jars"
            {
                custom rel material:binding = None
            }
        }
    }
}

