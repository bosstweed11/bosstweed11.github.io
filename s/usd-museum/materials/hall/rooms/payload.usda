        def Material "surfaces_Card"
        {
            token outputs:surface.connect = </Rooms/Looks/surfaces_Card/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor.connect = </Rooms/Looks/surfaces_Card/Tex.outputs:rgb>
                float inputs:opacity.connect = </Rooms/Looks/surfaces_Card/Tex.outputs:a>
                float inputs:opacityThreshold = 0.5
                float inputs:roughness = 1
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }

            def Shader "St"
