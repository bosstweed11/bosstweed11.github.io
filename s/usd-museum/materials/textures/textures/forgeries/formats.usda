#usda 1.0
(
    defaultPrim = "textures"
    doc = "Forgery formats on piece png16: 16-bit PNG and EXR unsupported: two magenta swatches. This is what a viewer with that bug shows; the correct exhibit is ../textures.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../textures.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "textures"
{
    over "Pieces"
    {
        over "png16"
        {
            over "Looks"
            {
                over "Swatch"
                {
                    over "Tex"
                    {
                        asset inputs:file = @./textures/fmt_16bit.unsupported.png@
                    }
                }
            }
        }

        over "exr"
        {
            over "Looks"
            {
                over "Swatch"
                {
                    over "Tex"
                    {
                        asset inputs:file = @./textures/fmt_half.unsupported.exr@
                    }
                }
            }
        }
    }
}

