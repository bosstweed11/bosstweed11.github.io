#usda 1.0
(
    defaultPrim = "textures"
    doc = "Forgery connections on piece tiles: connections not followed: a red swatch and a red ball. This is what a viewer with that bug shows; the correct exhibit is ../textures.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../textures.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "textures"
{
    over "Pieces"
    {
        over "tiles"
        {
            over "Looks"
            {
                over "Tiles"
                {
                    over "Surface"
                    {
                        color3f inputs:diffuseColor = (0.9, 0.05, 0.05)
                        color3f inputs:diffuseColor.connect = None
                    }
                }
            }
        }

        over "bumps"
        {
            over "Looks"
            {
                over "Bumps"
                {
                    over "Surface"
                    {
                        color3f inputs:diffuseColor = (0.9, 0.05, 0.05)
                        color3f inputs:diffuseColor.connect = None
                        normal3f inputs:normal = None
                        normal3f inputs:normal.connect = None
                    }
                }
            }
        }
    }
}

