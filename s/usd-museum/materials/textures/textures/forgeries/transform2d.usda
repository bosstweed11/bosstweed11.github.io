#usda 1.0
(
    defaultPrim = "textures"
    doc = "Forgery transform2d on piece tiles: UsdTransform2d ignored: big tiles square-on. This is what a viewer with that bug shows; the correct exhibit is ../textures.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../textures.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "textures"
{
    over "Pieces"
    {
        over "tiles"
        {
            over "Looks"
            {
                over "Tiles"
                {
                    over "Tex"
                    {
                        float2 inputs:st = None
                        float2 inputs:st.connect = </textures/Pieces/tiles/Looks/Tiles/St.outputs:result>
                    }
                }
            }
        }
    }
}

