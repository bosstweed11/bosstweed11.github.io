#usda 1.0
(
    defaultPrim = "textures"
    doc = "Forgery normalmap on piece bumps: normal map scale/bias ignored: the ball dark on one side. This is what a viewer with that bug shows; the correct exhibit is ../textures.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../textures.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "textures"
{
    over "Pieces"
    {
        over "bumps"
        {
            over "Looks"
            {
                over "Bumps"
                {
                    over "Normal"
                    {
                        float inputs:bias = None
                        float inputs:scale = None
                    }
                }
            }
        }
    }
}

