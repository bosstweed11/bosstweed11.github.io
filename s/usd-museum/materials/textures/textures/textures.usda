#usda 1.0
(
    defaultPrim = "textures"
    doc = "Exhibit materials.textures.textures: Texture networks and files. Look for: each piece matches the reference print above it. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "textures" (
    prepend apiSchemas = ["AuthorshipAPI:claude", "AuthorshipAPI:build", "AssetPreviewsAPI"]
    assetInfo = {
        asset identifier = @./textures.usda@
        string name = "textures"
        dictionary previews = {
            dictionary thumbnails = {
                dictionary default = {
                    asset defaultImage = @./thumbnail.jpg@
                }
            }
        }
    }
    customData = {
        dictionary museum = {
            string[] belt = ["11.Network", "11.Files"]
            string id = "materials.textures.textures"
            string look_for = "each piece matches the reference print above it"
            string title = "Texture networks and files"
            string wg = "materials"
        }
    }
    kind = "assembly"
    prepend payload = @./payload.usda@
)
{
    uniform string authorship:build:created = "2026-11-12T20:35:05-08:00"
    uniform string[] authorship:build:creator = ["usd-tour museum/src/export.py"]
    uniform string authorship:build:description = "Written through OpenUSD's Python API by usd-tour's build and export scripts (written by Claude Opus 5.5)."
    uniform string authorship:build:digitalSourceType = "http://cv.iptc.org/newscodes/digitalsourcetype/algorithmicMedia"
    uniform string[] authorship:build:inputs = ["source", "usd-tour 91b777d"]
    uniform string authorship:build:softwarePackage = "OpenUSD"
    uniform string authorship:build:softwareVersion = "26.11"
    uniform string authorship:build:usageTerms = "CC0-1.0"
    uniform string authorship:claude:created = "2026-11-12T20:35:05-08:00"
    uniform string[] authorship:claude:creator = ["Claude Opus 5.5 (Anthropic)"]
    uniform string authorship:claude:description = "Claude Opus 5.5, working in Claude Code, built every prim in this museum: it designed the exhibits and wrote the usd-tour scripts that author them."
    uniform string authorship:claude:digitalSourceType = "http://cv.iptc.org/newscodes/digitalsourcetype/trainedAlgorithmicMedia"
    uniform string[] authorship:claude:inputs = ["source", "usd-tour 91b777d"]
    uniform string authorship:claude:softwarePackage = "com.anthropic.claude"
    uniform string authorship:claude:softwareVersion = "claude-opus-5-5"
    uniform string authorship:claude:usageTerms = "CC0-1.0"

    over "Pieces"
    {
        over "tiles" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Network/UsdTransform2d"]
                    string[] features = ["SHADE-PREVIEW.transform2d"]
                    string[] forgeries = ["transform2d", "wrap", "connections"]
                    string reference = "its reference print"
                }
            }
            doc = "a swatch through UsdTransform2d (rotation 45, scale 2, wrap repeat)"
        )
        {
        }

        over "bumps" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Network/normal map"]
                    string[] features = ["SHADE-PREVIEW.normals"]
                    string[] forgeries = ["normalmap", "connections"]
                    string reference = "its reference print"
                }
            }
            doc = "a shader ball with a tangent-space normal map (scale and bias)"
        )
        {
        }

        over "leaf" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Network/opacityThreshold"]
                    string[] features = ["SHADE-PREVIEW.cutout"]
                    string[] forgeries = ["threshold"]
                    string reference = "its reference print"
                }
            }
            doc = "a card cut by its alpha (opacityThreshold 0.5)"
        )
        {
        }

        over "png8" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Files/PNG 8-bit"]
                    string[] features = ["SHADE-PREVIEW.files"]
                    string reference = "its reference print"
                }
            }
            doc = "the picture as an 8-bit PNG"
        )
        {
        }

        over "png16" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Files/PNG 16-bit"]
                    string[] features = ["SHADE-PREVIEW.files"]
                    string[] forgeries = ["formats"]
                    string reference = "its reference print"
                }
            }
            doc = "the picture as a 16-bit PNG"
        )
        {
        }

        over "exr" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Files/EXR half"]
                    string[] features = ["SHADE-PREVIEW.files"]
                    string[] forgeries = ["formats"]
                    string reference = "its reference print"
                }
            }
            doc = "the picture as a half-float EXR"
        )
        {
        }

        over "udim" (
            customData = {
                dictionary museum = {
                    string[] belt = ["11.Files/UDIM"]
                    string[] features = ["SHADE-PREVIEW.udim"]
                    string[] forgeries = ["udim", "misplaced"]
                    string reference = "its reference print"
                }
            }
            doc = "one quad, u 0-4, reading udim.<UDIM>.png tiles 1001-1004"
        )
        {
        }
    }
}

