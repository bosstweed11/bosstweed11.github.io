#usda 1.0
(
    defaultPrim = "machine"
    doc = "Forgery physicsbinding on piece materials: the physics material binding used for rendering: platform, ramp, fulcrum and posts red. This is what a viewer with that bug shows; the correct exhibit is ../machine.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 234
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../machine.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "machine"
{
    over "Pieces"
    {
        over "Rig"
        {
            over "Static"
            {
                over "Platform"
                {
                    over "Shape"
                    {
                        custom rel material:binding = </machine/Pieces/Rig/PhysicsMaterials/Wood>
                    }
                }

                over "Ramp"
                {
                    over "Shape"
                    {
                        custom rel material:binding = </machine/Pieces/Rig/PhysicsMaterials/Wood>
                    }
                }

                over "Fulcrum"
                {
                    over "Shape"
                    {
                        custom rel material:binding = </machine/Pieces/Rig/PhysicsMaterials/Wood>
                    }
                }

                over "Gantry"
                {
                    over "Post"
                    {
                        custom rel material:binding = </machine/Pieces/Rig/PhysicsMaterials/Steel>
                    }
                }

                over "BellPost"
                {
                    over "Post"
                    {
                        custom rel material:binding = </machine/Pieces/Rig/PhysicsMaterials/Steel>
                    }
                }
            }
        }
    }
}

