#usda 1.0
(
    "animation.clips.clips: the cart every piece instances. Its tub reads primvars:displayColor, authored on each instance root, not here. Transform-only (OpenExec)."
    defaultPrim = "Cart"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Cart" (
    kind = "component"
)
{
    def Scope "Looks"
    {
        def Material "Tub"
        {
            token outputs:surface.connect = </Cart/Looks/Tub/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Cart/Looks/Tub/Color.outputs:result>
                float inputs:roughness = 0.55
                color3f inputs:specularColor = (0.04, 0.04, 0.04)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }

            def Shader "Color"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                float3 inputs:fallback = (0.5, 0.5, 0.5)
                string inputs:varname = "displayColor"
                float3 outputs:result
            }
        }

        def Material "Chassis"
        {
            token outputs:surface.connect = </Cart/Looks/Chassis/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.021980947, 0.021980947, 0.024515014)
                float inputs:roughness = 0.6
                color3f inputs:specularColor = (0.04, 0.04, 0.04)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }

        def Material "Lamp"
        {
            token outputs:surface.connect = </Cart/Looks/Lamp/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor = (1, 0.84808826, 0.44798842)
                float inputs:roughness = 1
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

