#usda 1.0
(
    "USD Museum, Animation wing, Characters gallery: the skinned hero walks to his gold mark, the skull in his hand; his ARKit face (52 blend shapes, an in-between) on his own skeleton, gold outlines its expected lips, brows, lids and cheeks; his voice composes through +8; his left wrist twisted round by dual quaternion skinning (a red core hides inside it). Built by src/build.py; do not edit."
    defaultPrim = "Exhibit"
    endTimeCode = 344
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @./payload_data.usdc@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

