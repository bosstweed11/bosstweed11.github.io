#usda 1.0
(
    "A human head with Apple ARKit's 52 facial blend shapes (ARFaceAnchor.BlendShapeLocation), generated by animation.characters.skinning/src/face.py (our own geometry), for the hero. Life size, metres; the face looks down +Z, its left is +X. Bound to the hero's Neck and Head joints; geomBindTransform puts its pivot on his Head joint. The mesh lists its shapes alphabetically (his animation lists them in Apple's order). jawOpen has an in-between 'Round' at 0.5."
    defaultPrim = "Face"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

