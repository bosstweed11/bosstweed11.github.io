#usda 1.0
(
    defaultPrim = "skinning"
    doc = "Forgery offset-ignored on piece audio: the +8 offset ignored: the speaker shows at r = 36, before the band. This is what a viewer with that bug shows; the correct exhibit is ../skinning.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 344
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../skinning.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "skinning"
{
    over "Voice"
    {
        over "Audio"
        {
            uniform timecode endTime = 245
            uniform timecode startTime = 189

            over "SpeakerIcon"
            {
                token visibility = "inherited"
                token visibility.timeSamples = {
                    1: "invisible",
                    189: "inherited",
                    246: "invisible",
                }
            }
        }
    }
}

