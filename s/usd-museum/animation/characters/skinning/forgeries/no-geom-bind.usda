#usda 1.0
(
    defaultPrim = "skinning"
    doc = "Forgery no-geom-bind on piece geom-bind: geomBindTransform ignored: the skull floats away from his hand. This is what a viewer with that bug shows; the correct exhibit is ../skinning.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 344
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../skinning.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "skinning"
{
    over "Hero"
    {
        over "Performer"
        {
            over "RightHand"
            {
                over "Skull"
                {
                    matrix4d primvars:skel:geomBindTransform = None
                }
            }
        }
    }
}

