#usda 1.0
(
    defaultPrim = "skinning"
    doc = "Forgery not-read on piece audio: SpatialAudio not read (simulated): no speaker while the playhead is in the band. This is what a viewer with that bug shows; the correct exhibit is ../skinning.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 344
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../skinning.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "skinning"
{
    over "Voice"
    {
        over "Audio"
        {
            uniform timecode endTime = 0
            uniform asset filePath = @@
            uniform token playbackMode = "onceFromStart"
            uniform timecode startTime = 0

            over "SpeakerIcon" (
                active = false
            )
            {
            }
        }
    }
}

