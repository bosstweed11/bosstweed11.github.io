#usda 1.0
(
    defaultPrim = "skinning"
    doc = "Forgery unsupported on piece blend-shapes: blend shapes unsupported: a closed mouth inside the open ring. This is what a viewer with that bug shows; the correct exhibit is ../skinning.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 344
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../skinning.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "skinning"
{
    over "Hero"
    {
        over "Performer"
        {
            over "Geom"
            {
                over "ArkitFace"
                {
                    over "Mesh"
                    {
                        uniform token[] skel:blendShapes = None
                        custom rel skel:blendShapeTargets = None
                    }
                }
            }
        }
    }
}

