#usda 1.0
(
    defaultPrim = "skinning"
    doc = "Forgery linear on piece dual-quaternion: dual quaternion unsupported: his bent elbow collapses, the gold core pokes through. This is what a viewer with that bug shows; the correct exhibit is ../skinning.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 344
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../skinning.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "skinning"
{
    over "Hero"
    {
        over "Performer"
        {
            over "Geom"
            {
                over "RightArm"
                {
                    uniform token primvars:skel:skinningMethod = "classicLinear"
                }
            }
        }
    }
}

