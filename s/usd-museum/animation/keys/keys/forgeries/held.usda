#usda 1.0
(
    defaultPrim = "keys"
    doc = "Forgery held on piece vector: the vector held between keys: the cart waits at the start, off the playhead. This is what a viewer with that bug shows; the correct exhibit is ../keys.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 504
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @./held_data.usdc@,
        @../keys.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "keys"
{
    over "Stands"
    {
        over "Types"
        {
            over "Pieces"
            {
                over "Vector"
                {
                    over "Cart"
                    {
                        point3f[] points
                    }
                }
            }
        }
    }
}

