#usda 1.0
(
    defaultPrim = "keys"
    doc = "Forgery first-number-only on piece vector: only the vector's first number blends: the cart runs level, below the slope. This is what a viewer with that bug shows; the correct exhibit is ../keys.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 504
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @./first-number-only_data.usdc@,
        @../keys.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "keys"
{
    over "Stands"
    {
        over "Types"
        {
            over "Pieces"
            {
                over "Vector"
                {
                    over "Cart"
                    {
                        point3f[] points
                    }
                }
            }
        }
    }
}

