        def Material "F001_Mat"
        {
            token outputs:surface.connect = </Stand/Ruler/F001_Mat/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor.connect = </Stand/Ruler/F001_Mat/Tex.outputs:rgb>
                float inputs:opacity.connect = </Stand/Ruler/F001_Mat/Tex.outputs:a>
                float inputs:opacityThreshold = 0.5
                float inputs:roughness = 1
