        def Material "F001_Mat"
        {
            token outputs:surface.connect = </Stand/Ruler/F001_Mat/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor.connect = </Stand/Ruler/F001_Mat/Tex.outputs:rgb>
                float inputs:opacity.connect = </Stand/Ruler/F001_Mat/Tex.outputs:a>
                float inputs:opacityThreshold = 0.5
                float inputs:roughness = 1
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/labels_atlas.png@
                float4 inputs:scale = (1, 1, 1, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Stand/Ruler/F001_Mat/Tex_Atlas.outputs:result>
                float outputs:a
                float3 outputs:rgb
            }

            def Shader "Tex_Atlas"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </Stand/Ruler/F001_Mat/St.outputs:result>
                float2 inputs:scale = (0.015625, 0.114285715)
                float2 inputs:translation = (0.68603516, 0.08768473)
                float2 outputs:result
            }
        }

