#usda 1.0
(
    defaultPrim = "offsets"
    doc = "Forgery rate30-ignored on piece fps30: 30 time codes a second read as 24: the cart runs slow, behind its track. This is what a viewer with that bug shows; the correct exhibit is ../offsets.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 313
