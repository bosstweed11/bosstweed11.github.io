#usda 1.0
(
    defaultPrim = "offsets"
    doc = "Forgery zero-applied on piece zero: scale 0's offset applied anyway: the cart starts 40 frames late. This is what a viewer with that bug shows; the correct exhibit is ../offsets.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 313
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../offsets.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "offsets"
{
    over "Stands"
