#usda 1.0
(
    defaultPrim = "offsets"
    doc = "Forgery wrong-order on piece subref: the reference's offset applied after the sublayer's scale: the cart runs 10 frames early. This is what a viewer with that bug shows; the correct exhibit is ../offsets.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 313
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../offsets.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "offsets"
{
    over "Stands"
