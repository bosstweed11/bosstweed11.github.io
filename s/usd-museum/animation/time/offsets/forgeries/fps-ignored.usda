#usda 1.0
(
    defaultPrim = "offsets"
    doc = "Forgery fps-ignored on piece sub12: framesPerSecond skipped when timeCodesPerSecond is missing (read as 24): no stretch, the cart finishes before the track's plateau. This is what a viewer with that bug shows; the correct exhibit is ../offsets.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 313
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../offsets.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "offsets"
{
    over "Stands"
    {
        over "Rates"
        {
            over "Pieces"
            {
                over "Sub12"
                {
                    over "Ride"
                    {
                        over "Cart"
                        {
                            matrix4d xformOp:transform = None
