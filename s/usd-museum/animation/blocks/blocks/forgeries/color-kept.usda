#usda 1.0
(
    defaultPrim = "blocks"
    doc = "Forgery color-kept on piece color: the color block ignored: a red cart on the grey track. This is what a viewer with that bug shows; the correct exhibit is ../blocks.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 168
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../blocks.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "blocks"
{
    over "Stands"
    {
        over "Blocks"
        {
            over "Pieces"
            {
                over "Color"
                {
                    over "Ride"
                    {
                        over "Cart"
                        {
                            over "Body" (
                                instanceable = false
                            )
                            {
                                color3f[] primvars:displayColor = [(0.6382832, 0.010022826, 0.013411749)] (
                                    interpolation = "constant"
                                )
                            }
                        }
                    }
                }
            }
        }
    }
}

