#usda 1.0
(
    defaultPrim = "blocks"
    doc = "Forgery as-value-block on piece animation: the animation block read as a value block: the still value gone too, the cart drops to the floor. This is what a viewer with that bug shows; the correct exhibit is ../blocks.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 168
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../blocks.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "blocks"
{
    over "Stands"
    {
        over "Blocks"
        {
            over "Pieces"
            {
                over "Animation"
                {
                    over "Ride"
                    {
                        over "Cart"
                        {
                            matrix4d xformOp:transform = None
                        }
                    }
                }
            }
        }
    }
}

