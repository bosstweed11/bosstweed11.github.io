#usda 1.0
(
    defaultPrim = "motion"
    doc = "Forgery velocities-ignored on piece drops: velocities ignored: every streak hangs at its nozzle; the lit hoops are empty. This is what a viewer with that bug shows; the correct exhibit is ../motion.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 96
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../motion.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

