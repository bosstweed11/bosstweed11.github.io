#usda 1.0
(
    defaultPrim = "motion"
    doc = "Forgery ignored on piece widths: widths ignored: a 2 cm dot inside the ball's lit hoop. This is what a viewer with that bug shows; the correct exhibit is ../motion.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 96
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../motion.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "motion"
{
    over "Throw"
    {
        over "Ball"
        {
            float[] widths = [0.02] (
                interpolation = "constant"
            )
        }
    }
}

