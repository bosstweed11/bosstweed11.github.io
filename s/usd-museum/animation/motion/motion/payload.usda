#usda 1.0
(
    "USD Museum, Animation wing, Motion gallery: a ball thrown under gravity and streaks falling at constant speed, each authored only when thrown or released (points, velocities, accelerations, widths). The chalk arc, the hoops and when they light are the answer key, baked from p + v dt + a dt^2/2. Built by src/build.py; do not edit."
    defaultPrim = "Exhibit"
    endTimeCode = 96
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

