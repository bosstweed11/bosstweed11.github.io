#usda 1.0
(
    "USD Museum exhibit instancing.native.native: the spec's instancing examples (vases on bases in the color they must show) and nested instanced cases on carts (each cart's color on its instance root; one de-instanced stack). Built by src/build.py."
    defaultPrim = "Exhibit"
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

