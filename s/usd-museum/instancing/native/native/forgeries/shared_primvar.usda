#usda 1.0
(
    defaultPrim = "native"
    doc = "Forgery shared_primvar on piece pallet: one primvar per prototype, not per instance: cart 2 teal on its purple base. This is what a viewer with that bug shows; the correct exhibit is ../native.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../native.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "native"
{
    over "Pallet"
    {
        over "Cart2" (
            instanceable = false
        )
        {
            color3f[] primvars:displayColor = [(0.010329823, 0.31398872, 0.08021982)] (
                interpolation = "constant"
            )
        }
    }
}

