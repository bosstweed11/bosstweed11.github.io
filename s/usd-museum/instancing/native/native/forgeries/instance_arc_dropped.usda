#usda 1.0
(
    defaultPrim = "native"
    doc = "Forgery instance_arc_dropped on piece examples: the arc on the instance ignored: Asset_3 teal on its gold base. This is what a viewer with that bug shows; the correct exhibit is ../native.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../native.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "native"
{
    over "Examples"
    {
        over "Ex1"
        {
            over "Asset_3" (
                instanceable = false
            )
            {
                over "Vase"
                {
                    color3f[] primvars:displayColor = [(0.010329823, 0.31398872, 0.08021982)] (
                        interpolation = "constant"
                    )
                }
            }
        }
    }
}

