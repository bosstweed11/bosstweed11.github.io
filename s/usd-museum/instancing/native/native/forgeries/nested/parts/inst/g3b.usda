#usda 1.0
(
    "Group layer: an instanceable Asset (references asset.usda) with a red over on its vase (ancestral to the instance: ignored); an over on /class_Asset glazes it (an implied inherit: kept)."
    defaultPrim = "Group_2"
)

over "class_Asset"
{
    over "Vase"
    {
        color3f[] primvars:displayColor = [(0.7758222, 0.2541521, 0.013702083)] (
            interpolation = "constant"
        )
    }
}

def Xform "Group_2"
{
    def Xform "Asset" (
        instanceable = true
        prepend references = @./asset.usda@
    )
    {
        over "Vase"
        {
            color3f[] primvars:displayColor = [(0.63075715, 0.000607054, 0.010960094)] (
                interpolation = "constant"
            )
        }
    }
}

