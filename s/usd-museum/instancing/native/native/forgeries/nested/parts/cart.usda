#usda 1.0
(
    "instancing.native.native: a luggage cart of two instanced stacks (./stack.usda). No color here."
    defaultPrim = "Cart"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Cart" (
    kind = "group"
)
{
    def Scope "Looks"
    {
        def Material "Steel"
        {
            token outputs:surface.connect = </Cart/Looks/Steel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.10653923, 0.112804785, 0.13286832)
                float inputs:roughness = 0.45
                color3f inputs:specularColor = (0.04, 0.04, 0.04)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }

        def Material "Rubber"
        {
            token outputs:surface.connect = </Cart/Looks/Rubber/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0039359396, 0.0039359396, 0.0039359396)
                float inputs:roughness = 0.9
                color3f inputs:specularColor = (0.04, 0.04, 0.04)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

