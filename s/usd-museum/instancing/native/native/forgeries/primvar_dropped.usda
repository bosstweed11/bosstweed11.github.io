#usda 1.0
(
    defaultPrim = "native"
    doc = "Forgery primvar_dropped on piece pallet: primvars on instance roots not inherited into prototypes: grey cases on colored bases. This is what a viewer with that bug shows; the correct exhibit is ../native.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../native.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "native"
{
    over "Pallet"
    {
        over "Cart1" (
            instanceable = false
        )
        {
            float primvars:displayColor = None
        }

        over "Cart2" (
            instanceable = false
        )
        {
            float primvars:displayColor = None
        }

        over "Cart3"
        {
            float primvars:displayColor = None
        }
    }
}

