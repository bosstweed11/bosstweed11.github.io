#usda 1.0
(
    defaultPrim = "native"
    doc = "Forgery ancestral_kept on piece examples: an ancestral over applied to an instance: a red vase on a teal base (example 2). This is what a viewer with that bug shows; the correct exhibit is ../native.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
