#usda 1.0
(
    defaultPrim = "native"
    doc = "Forgery implied_dropped on piece examples: implied inherits ignored in instances: example 3 teal on blue and orange bases. This is what a viewer with that bug shows; the correct exhibit is ../native.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../native.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "native"
{
    over "Examples"
    {
        over "Ex3"
        {
            over "LeftGroup"
            {
                over "Asset" (
                    instanceable = false
                )
                {
                    over "Vase"
                    {
                        color3f[] primvars:displayColor = [(0.010329823, 0.31398872, 0.08021982)] (
                            interpolation = "constant"
                        )
                    }
                }
            }

            over "RightGroup"
            {
                over "Asset" (
                    instanceable = false
                )
                {
                    over "Vase"
                    {
                        color3f[] primvars:displayColor = [(0.010329823, 0.31398872, 0.08021982)] (
                            interpolation = "constant"
                        )
                    }
                }
            }
        }
    }
}

