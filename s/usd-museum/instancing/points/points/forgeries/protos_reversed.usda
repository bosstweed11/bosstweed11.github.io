#usda 1.0
(
    defaultPrim = "points"
    doc = "Forgery protos_reversed on piece masks: protoIndices read backwards: green and yellow books over the wrong chips. This is what a viewer with that bug shows; the correct exhibit is ../points.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../points.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "points"
{
    over "Shelves"
    {
        over "Masks"
        {
            int[] protoIndices = [2, 1, 0, 3, 1, 0, 2, 1, 0, 2, 1, 0, 2, 1, 0, 2, 1, 0, 2, 1, 0, 2, 1, 0, 3, 1]
        }
    }
}

