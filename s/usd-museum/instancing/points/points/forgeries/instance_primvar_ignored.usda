#usda 1.0
(
    defaultPrim = "points"
    doc = "Forgery instance_primvar_ignored on piece colors: the per-instance primvar ignored: grey books over a rainbow of chips. This is what a viewer with that bug shows; the correct exhibit is ../points.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../points.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "points"
{
    over "Shelves"
    {
        over "Colors"
        {
            float primvars:displayColor = None
        }
    }
}

