                asset inputs:file = @./textures/labels_atlas.png@
                float4 inputs:scale = (1, 1, 1, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Exhibit/Looks/Sign_Books/Tex_Atlas.outputs:result>
                float outputs:a
