#usda 1.0
(
    defaultPrim = "crowds"
    doc = "Forgery cards_not_drawn on piece cards: model:drawMode ignored: red WRONG boxes in the back rows. This is what a viewer with that bug shows; the correct exhibit is ../crowds.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 240
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../crowds.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

