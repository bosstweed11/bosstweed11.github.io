    def "Anims" (
        prepend references = @./anims.usda@
    )
    {
    }

    class "_Spectator" (
        prepend apiSchemas = ["SkelBindingAPI"]
    )
    {
        rel skel:animationSource = </Audience/Anims/ArmsUp>

        over "Looks"
        {
            over "Shirt"
            {
                over "Read"
                {
                    custom float3 inputs:fallback = (1, 0, 0.85)
                }
            }
        }
    }

    def Xform "Front"
