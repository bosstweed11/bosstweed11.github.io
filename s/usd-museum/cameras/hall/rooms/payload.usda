#usda 1.0
(
    "The Cameras wing's rooms: bays, doorways, gallery placards and stands (museum/src/wing.py). A payload of the wing."
    defaultPrim = "Rooms"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Rooms" (
    kind = "group"
)
{
    def Scope "Looks"
    {
        def Material "plaster"
        {
            token outputs:surface.connect = </Rooms/Looks/plaster/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.34239164, 0.30699933, 0.26327342)
                float inputs:roughness = 0.9
                color3f inputs:specularColor = (0.04, 0.04, 0.04)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }

        def Material "pilaster"
        {
            token outputs:surface.connect = </Rooms/Looks/pilaster/Surface.outputs:surface>

            def Shader "Surface"
            {
