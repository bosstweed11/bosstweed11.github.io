#usda 1.0
(
    defaultPrim = "settings"
    doc = "Forgery settings_ignored on piece settings: settings ignored: a 16:9 picture over the letterbox ticks. This is what a viewer with that bug shows; the correct exhibit is ../settings.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../settings.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "settings"
{
    over "Pieces"
    {
        over "Set"
        {
            over "Prop"
            {
                over "MonitorSettings"
                {
                    over "Baked"
                    {
                        over "Picture"
                        {
                            float3[] extent = [(-0.02, 1.2, -1.49), (1.02, 1.785, -1.49)]
                            point3f[] points = [(-0.02, 1.2, -1.49), (1.02, 1.2, -1.49), (1.02, 1.785, -1.49), (-0.02, 1.785, -1.49)]
                        }
                    }
                }
            }
        }
    }
}

