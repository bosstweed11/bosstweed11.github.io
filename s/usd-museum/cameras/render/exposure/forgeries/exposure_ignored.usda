#usda 1.0
(
    defaultPrim = "exposure"
    doc = "Forgery exposure_ignored on piece minus1: exposure ignored: the -1 monitor's white edge two steps left of its tick (step 5, not 7). This is what a viewer with that bug shows; the correct exhibit is ../exposure.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../exposure.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "exposure"
{
    over "Pieces"
    {
        over "Minus1"
        {
            over "Camera"
            {
                float exposure = 0
            }
        }
    }
}

