#usda 1.0
(
    defaultPrim = "exposure"
    doc = "Forgery fstop_ignored on piece base: fStop ignored (1): every wedge 4x too bright, white edges four steps left of their ticks. This is what a viewer with that bug shows; the correct exhibit is ../exposure.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../exposure.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "exposure"
{
    over "Pieces"
    {
        over "Base"
        {
            over "Camera"
            {
                float exposure:fStop = 1
            }
        }

        over "Minus1"
        {
            over "Camera"
            {
                float exposure:fStop = 1
            }
        }

        over "Iso1600"
        {
            over "Camera"
            {
                float exposure:fStop = 1
            }
        }
    }
}

