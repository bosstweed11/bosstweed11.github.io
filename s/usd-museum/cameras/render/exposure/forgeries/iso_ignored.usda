#usda 1.0
(
    defaultPrim = "exposure"
    doc = "Forgery iso_ignored on piece iso1600: iso ignored (100): every wedge an eighth as bright, no step white. This is what a viewer with that bug shows; the correct exhibit is ../exposure.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../exposure.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "exposure"
{
    over "Pieces"
    {
        over "Base"
        {
            over "Camera"
            {
                float exposure:iso = 100
            }
        }

        over "Minus1"
        {
            over "Camera"
            {
                float exposure:iso = 100
            }
        }

        over "Iso1600"
        {
            over "Camera"
            {
                float exposure:iso = 100
            }
        }
    }
}

