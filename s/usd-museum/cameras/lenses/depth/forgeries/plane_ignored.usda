#usda 1.0
(
    defaultPrim = "depth"
    doc = "Forgery plane_ignored on piece clipping: the clip plane ignored: the half post whole. This is what a viewer with that bug shows; the correct exhibit is ../depth.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../depth.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "depth"
{
    over "Pieces"
    {
        over "Clip"
        {
            over "Camera"
            {
                float4[] clippingPlanes = []
            }

            over "Ghost"
            {
                over "PlaneMat" (
                    active = false
                )
                {
                }

                over "Plane" (
                    active = false
                )
                {
                }
            }
        }
    }
}

