#usda 1.0
(
    "USD Museum exhibit cameras.lenses.lenses: four cameras (18, 50, 135 mm, orthographic) on tripods, each looking into its own copy of one small room whose opening is its frame (printed from the rule), its monitor (what it sees, baked) and its frustum ghost (parts/ghosts.usda, baked). Built by src/build.py."
    defaultPrim = "Exhibit"
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @./parts/ghosts.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

