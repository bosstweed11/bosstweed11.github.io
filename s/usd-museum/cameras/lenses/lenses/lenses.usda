#usda 1.0
(
    defaultPrim = "lenses"
    doc = "Exhibit cameras.lenses.lenses: Focal length, apertures, orthographic. Look for: every monitor shows its colored band all round and no red; every ghost frustum ends on its room's opening; inside each camera (the in_* holds) the band runs all round the view, no red: the same vase in a room that stretches away at 18 mm and flattens at 135 mm; orthographic shows no side wall. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "lenses" (
    prepend apiSchemas = ["AuthorshipAPI:claude", "AuthorshipAPI:build", "AssetPreviewsAPI"]
    assetInfo = {
        asset identifier = @./lenses.usda@
        string name = "lenses"
        dictionary previews = {
            dictionary thumbnails = {
                dictionary default = {
                    asset defaultImage = @./thumbnail.jpg@
                }
            }
        }
    }
    customData = {
        dictionary museum = {
            string[] belt = ["21.L18", "21.L50", "21.L135", "21.Ortho"]
            string id = "cameras.lenses.lenses"
            string look_for = "every monitor shows its colored band all round and no red; every ghost frustum ends on its room's opening; inside each camera (the in_* holds) the band runs all round the view, no red: the same vase in a room that stretches away at 18 mm and flattens at 135 mm; orthographic shows no side wall"
            string title = "Focal length, apertures, orthographic"
            string wg = "none"
        }
    }
    kind = "assembly"
    prepend payload = @./payload.usda@
)
{
    uniform string authorship:build:created = "2026-11-13T20:04:05-08:00"
    uniform string[] authorship:build:creator = ["usd-tour museum/src/export.py"]
    uniform string authorship:build:description = "Written through OpenUSD's Python API by usd-tour's build and export scripts (written by Claude Opus 5.5)."
    uniform string authorship:build:digitalSourceType = "http://cv.iptc.org/newscodes/digitalsourcetype/algorithmicMedia"
