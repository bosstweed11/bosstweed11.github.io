        def Material "population_Card"
        {
            token outputs:surface.connect = </Rooms/Looks/population_Card/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor.connect = </Rooms/Looks/population_Card/Tex.outputs:rgb>
                float inputs:opacity.connect = </Rooms/Looks/population_Card/Tex.outputs:a>
                float inputs:opacityThreshold = 0.5
                float inputs:roughness = 1
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tex"
            {
