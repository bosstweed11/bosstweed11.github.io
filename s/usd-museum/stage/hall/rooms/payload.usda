#usda 1.0
(
    "The Stage wing's rooms: bays, doorways, gallery placards and stands (museum/src/wing.py). A payload of the wing."
    defaultPrim = "Rooms"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Rooms" (
    kind = "group"
)
