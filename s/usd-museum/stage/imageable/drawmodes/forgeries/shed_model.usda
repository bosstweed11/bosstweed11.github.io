#usda 1.0
(
    defaultPrim = "drawmodes"
    doc = "Forgery shed_model on piece shed: the kindless shed taken as a model: a red box (or nothing) where the green shed stands. This is what a viewer with that bug shows; the correct exhibit is ../drawmodes.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 216
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../drawmodes.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "drawmodes"
{
    over "Pieces"
    {
        over "Shed"
        {
            over "Turn"
            {
                over "House" (
                    kind = "component"
                )
                {
                    uniform bool model:applyDrawMode = 1
                }
            }
        }
    }
}

