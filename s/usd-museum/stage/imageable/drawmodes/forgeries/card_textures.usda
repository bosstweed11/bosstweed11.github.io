#usda 1.0
(
    defaultPrim = "drawmodes"
    doc = "Forgery card_textures on piece cards: card textures not read: plain blue cards where the house pictures belong. This is what a viewer with that bug shows; the correct exhibit is ../drawmodes.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 216
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../drawmodes.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "drawmodes"
{
    over "Pieces"
    {
        over "Cross"
        {
            over "Turn"
            {
                over "House"
                {
                    asset model:cardTextureXNeg = None
                    asset model:cardTextureXPos = None
                    asset model:cardTextureZPos = None
                }
            }
        }

        over "Box"
        {
            over "Turn"
            {
                over "House"
                {
                    asset model:cardTextureXNeg = None
                    asset model:cardTextureXPos = None
                    asset model:cardTextureYPos = None
                    asset model:cardTextureZPos = None
                }
            }
        }
    }
}

