#usda 1.0
(
    defaultPrim = "drawmodes"
    doc = "Forgery drawmodes_ignored on piece standins: draw modes ignored: four full houses, each with a red slab on its front. This is what a viewer with that bug shows; the correct exhibit is ../drawmodes.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 216
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../drawmodes.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "drawmodes"
{
    over "Pieces"
    {
        over "Bounds"
        {
            over "Turn"
            {
                over "House"
                {
                    uniform token model:drawMode = "inherited"
                }
            }
        }

        over "Cross"
        {
            over "Turn"
            {
                over "House"
                {
                    uniform token model:drawMode = "inherited"
                }
            }
        }

        over "Box"
        {
            over "Turn"
            {
                over "House"
                {
                    uniform token model:drawMode = "inherited"
                }
            }
        }

        over "Origin"
        {
            over "Turn"
            {
                over "House"
                {
                    uniform token model:drawMode = "inherited"
                }
            }
        }
    }
}

