#usda 1.0
(
    defaultPrim = "drawmodes"
    doc = "Forgery bounds_wrong on piece bounds: bounds from a wrong extent: the orange frame stands small inside its plate. This is what a viewer with that bug shows; the correct exhibit is ../drawmodes.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 216
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../drawmodes.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "drawmodes"
{
    over "Pieces"
    {
        over "Bounds"
        {
            over "Turn"
            {
                over "House"
                {
                    float3[] extentsHint = [(-4.032, 0, -3.072), (4.032, 8.16, 3.072)]
                }
            }
        }
    }
}

