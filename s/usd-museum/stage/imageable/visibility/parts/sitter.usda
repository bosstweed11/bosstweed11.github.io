#usda 1.0
(
    "stage.imageable.visibility: the sitter. visibility invisible at frame 1, inherited at 49, invisible at 145 (held: a token never interpolates)."
    defaultPrim = "Sitter"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Sitter" (
    kind = "component"
)
{
    token visibility.timeSamples = {
        1: "invisible",
        49: "inherited",
        145: "invisible",
    }

    def Scope "Looks"
    {
    }

    def "Body" (
        instanceable = true
        prepend references = @./bust.usda@
    )
    {
    }
}

