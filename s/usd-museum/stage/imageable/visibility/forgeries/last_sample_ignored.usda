#usda 1.0
(
    defaultPrim = "visibility"
    doc = "Forgery last_sample_ignored on piece samples: the last sample dropped: the bust still drawn at frame 180, past the band. This is what a viewer with that bug shows; the correct exhibit is ../visibility.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../visibility.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "visibility"
{
    over "Pieces"
    {
        over "Time"
        {
            over "Sitter"
            {
                token visibility = "inherited"
                token visibility.timeSamples = {
                    1: "invisible",
                    49: "inherited",
                }
            }
        }
    }
}

