#usda 1.0
(
    defaultPrim = "visibility"
    doc = "Forgery samples_ignored on piece samples: visibility samples ignored: the bust drawn at frame 20, before the blue band. This is what a viewer with that bug shows; the correct exhibit is ../visibility.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../visibility.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "visibility"
{
    over "Pieces"
    {
        over "Time"
        {
            over "Sitter"
            {
                token visibility = "inherited"
            }
        }
    }
}

