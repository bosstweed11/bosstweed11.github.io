#usda 1.0
(
    defaultPrim = "visibility"
    doc = "Forgery not_inherited on piece lamp: visibility not inherited: the red shade, pole and bulb drawn in the outline. This is what a viewer with that bug shows; the correct exhibit is ../visibility.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
