#usda 1.0
(
    defaultPrim = "visibility"
    doc = "Forgery invisible_drawn on piece lamp: visibility ignored: a red lamp inside its stays-empty outline. This is what a viewer with that bug shows; the correct exhibit is ../visibility.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../visibility.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "visibility"
{
    over "Pieces"
    {
        over "Lamp"
        {
            token visibility = "inherited"

            over "Base"
            {
                token visibility = "inherited"
            }
        }
    }
}

