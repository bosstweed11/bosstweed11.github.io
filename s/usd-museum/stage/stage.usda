#usda 1.0
(
    defaultPrim = "stage"
    doc = "The Stage wing: its hall and galleries, each exhibit an asset in <gallery>/<exhibit>/. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    fallbackPrimTypes = {
        token[] DeptBall = ["FacilityBall", "Sphere", "Cube"]
        token[] FancyLamp = ["Cylinder"]
    }
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

