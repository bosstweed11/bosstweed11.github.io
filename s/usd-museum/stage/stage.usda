        asset identifier = @./stage.usda@
        string name = "stage"
        dictionary previews = {
            dictionary thumbnails = {
                dictionary default = {
                    asset defaultImage = @./thumbnail.jpg@
                }
            }
        }
    }
    customData = {
        dictionary museum = {
            string id = "stage"
            string[] spec = ["stage_population", "schemas", "collections"]
            string title = "Stage wing"
            string wg = "core"
        }
    }
    kind = "assembly"
)
