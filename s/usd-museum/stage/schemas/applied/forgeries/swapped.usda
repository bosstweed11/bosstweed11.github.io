#usda 1.0
(
    defaultPrim = "applied"
    doc = "Forgery swapped on piece left-right: the multiple-apply instances confused: orange on the blue base, blue on the orange. This is what a viewer with that bug shows; the correct exhibit is ../applied.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../applied.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "applied"
{
    over "Pieces"
    {
        over "Pair"
        {
            custom rel material:binding:collection:Left = [
                </applied/Pieces/Pair.collection:left>,
                </applied/Pieces/Looks/Orange>,
            ]
            custom rel material:binding:collection:Right = [
                </applied/Pieces/Pair.collection:right>,
                </applied/Pieces/Looks/Blue>,
            ]
        }
    }
}

