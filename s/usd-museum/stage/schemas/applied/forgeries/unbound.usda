#usda 1.0
(
    defaultPrim = "applied"
    doc = "Forgery unbound on piece left-right: collection-based bindings ignored: red busts on the teal, blue and orange bases. This is what a viewer with that bug shows; the correct exhibit is ../applied.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../applied.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "applied"
{
    over "Pieces"
    {
        over "C"
        {
            custom rel material:binding:collection:set = None
        }

        over "Pair"
        {
            custom rel material:binding:collection:Left = None
            custom rel material:binding:collection:Right = None
        }
    }
}

