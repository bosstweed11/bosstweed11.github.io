#usda 1.0
(
    defaultPrim = "applied"
    doc = "Forgery instance_ignored on piece instance: CollectionAPI:set not applied: an unbound red bust on the teal base. This is what a viewer with that bug shows; the correct exhibit is ../applied.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../applied.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "applied"
{
    over "Pieces"
    {
        over "C" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float collection:set:expansionRule = None
            float collection:set:mode = None
        }
    }
}

