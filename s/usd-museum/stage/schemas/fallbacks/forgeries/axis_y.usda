#usda 1.0
(
    defaultPrim = "fallbacks"
    doc = "Forgery axis_y on piece Cylinder: the axis fallback read as Y: an upright log, a square outline inside the lying ghost's disc. This is what a viewer with that bug shows; the correct exhibit is ../fallbacks.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../fallbacks.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "fallbacks"
{
    over "Pieces"
    {
        over "Cylinder"
        {
            over "Log"
            {
                uniform token axis = "Y"
            }
        }
    }
}

