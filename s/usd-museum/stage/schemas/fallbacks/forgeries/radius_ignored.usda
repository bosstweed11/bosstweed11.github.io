#usda 1.0
(
    defaultPrim = "fallbacks"
    doc = "Forgery radius_ignored on piece radius: the radius fallback not 1 (read as 0.5): a half-size ball clear of both posts and the bar. This is what a viewer with that bug shows; the correct exhibit is ../fallbacks.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../fallbacks.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "fallbacks"
{
    float3[] extentsHint = [(-2.4, 0, -1.55), (2.4, 2.55, -0.334)]

    over "Pieces"
    {
        over "Sphere"
        {
            over "Ball"
