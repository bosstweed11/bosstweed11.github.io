#usda 1.0
(
    defaultPrim = "types"
    doc = "Forgery fallback_ignored on piece fallback: fallbackPrimTypes ignored: the column and ball ghosts empty. This is what a viewer with that bug shows; the correct exhibit is ../types.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    fallbackPrimTypes = {
        token[] DeptBall = ["FacilityBall", "Sphere", "Cube"]
        token[] FancyLamp = ["Cylinder"]
    }
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../types.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "types"
{
    over "Pieces"
    {
        over "Fallback"
        {
            over FancyLampUnmapped "FancyLamp"
            {
                float doubleSided = None
                float height = None
                float orientation = None
                float purpose = None
                float visibility = None
            }
        }

        over "Preference"
        {
            over DeptBallUnmapped "DeptBall"
            {
                float doubleSided = None
                float orientation = None
                float purpose = None
                float visibility = None
            }
        }
    }
}

