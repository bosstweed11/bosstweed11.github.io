#usda 1.0
(
    defaultPrim = "types"
    doc = "Forgery unknown_drawn on piece no-fallback: an unknown type drawn from its own attributes: red blades in the red outline. This is what a viewer with that bug shows; the correct exhibit is ../types.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    fallbackPrimTypes = {
        token[] DeptBall = ["FacilityBall", "Sphere", "Cube"]
        token[] FancyLamp = ["Cylinder"]
    }
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../types.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "types"
{
    over "Pieces"
    {
        over "NoFallback"
        {
            over Mesh "AlienPlant"
            {
                int[] cornerIndices = []
                float[] cornerSharpnesses = []
                int[] creaseIndices = []
                int[] creaseLengths = []
                float[] creaseSharpnesses = []
                token faceVaryingLinearInterpolation = "cornersPlus1"
                int[] holeIndices = []
                token interpolateBoundary = "edgeAndCorner"
                uniform token orientation = "rightHanded"
                uniform token purpose = "default"
                token triangleSubdivisionRule = "catmullClark"
                token visibility = "inherited"
            }
        }
    }
}

