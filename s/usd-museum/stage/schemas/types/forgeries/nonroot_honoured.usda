#usda 1.0
(
    defaultPrim = "types"
    doc = "Forgery nonroot_honoured on piece not-root: a fallback honoured from a non-root layer: a red column in the red outline. This is what a viewer with that bug shows; the correct exhibit is ../types.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    fallbackPrimTypes = {
        token[] DeptBall = ["FacilityBall", "Sphere", "Cube"]
        token[] FancyLamp = ["Cylinder"]
    }
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../types.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "types"
{
    over "Pieces"
    {
        over "NotRoot"
        {
            over Cylinder "OldLamp"
            {
                uniform bool doubleSided = 0
                double height = 2
                uniform token orientation = "rightHanded"
                uniform token purpose = "default"
                token visibility = "inherited"
            }
        }
    }
}

