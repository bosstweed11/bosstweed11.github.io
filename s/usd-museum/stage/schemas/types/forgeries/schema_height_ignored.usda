#usda 1.0
(
    defaultPrim = "types"
    doc = "Forgery schema_height_ignored on piece fallback: the Cylinder schema's fallback height not used: a half-height column floating mid-ghost, both ends empty. This is what a viewer with that bug shows; the correct exhibit is ../types.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    fallbackPrimTypes = {
        token[] DeptBall = ["FacilityBall", "Sphere", "Cube"]
        token[] FancyLamp = ["Cylinder"]
    }
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../types.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "types"
{
    over "Pieces"
    {
        over "Fallback"
        {
            over "FancyLamp"
            {
                double height = 1
            }
        }
    }
}

