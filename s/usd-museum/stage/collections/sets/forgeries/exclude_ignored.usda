#usda 1.0
(
    defaultPrim = "sets"
    doc = "Forgery exclude_ignored on piece excludes: excludes ignored: a blue cube drawn inside the red stays-empty outline. This is what a viewer with that bug shows; the correct exhibit is ../sets.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../sets.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "sets"
{
    over "Rows"
    {
        over "Excludes"
        {
            custom rel collection:lit:excludes = None
        }
    }
}

