#usda 1.0
(
    defaultPrim = "sets"
    doc = "Forgery root_ignored on piece includeRoot: includeRoot ignored: the bench empty over five blue silhouettes. This is what a viewer with that bug shows; the correct exhibit is ../sets.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../sets.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "sets"
{
    over "Rows"
    {
        over "Root"
        {
            uniform bool collection:lit:includeRoot = None
        }
    }
}

