#usda 1.0
(
    defaultPrim = "sets"
    doc = "Forgery explicit_ignored on piece explicitOnly: explicitOnly read as expandPrims: the row's include draws the prism inside its red outline. This is what a viewer with that bug shows; the correct exhibit is ../sets.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../sets.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "sets"
{
    over "Rows"
    {
        over "Explicit"
        {
            uniform token collection:lit:expansionRule = "expandPrims"
        }
    }
}

