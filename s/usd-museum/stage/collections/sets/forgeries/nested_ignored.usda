#usda 1.0
(
    defaultPrim = "sets"
    doc = "Forgery nested_ignored on piece included collection: the included collection not followed: no cone and no capsule over their blue silhouettes. This is what a viewer with that bug shows; the correct exhibit is ../sets.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../sets.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "sets"
{
    over "Rows"
    {
        over "Nested"
        {
            custom rel collection:lit:includes = [
                </sets/Rows/Nested/Cube>,
                </sets/Rows/Nested/Prism>,
            ]
        }
    }
}

