    customData = {
        dictionary museum = {
            string[] belt = ["27.Sets"]
            string id = "stage.collections.sets"
            string look_for = "a blue shape over every silhouette; every red outline stays empty (a different shape missing on each bench but includeRoot's)"
            string[] spec = ["collections"]
            string title = "Includes, excludes, expansion"
            string wg = "core"
        }
    }
    kind = "assembly"
    prepend payload = @./payload.usda@
)
