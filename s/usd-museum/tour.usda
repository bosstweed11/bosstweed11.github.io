#usda 1.0
(
    customLayerData = {
        dictionary museum = {
            bool exec = 0
            string[] wings = ["foundations", "composition", "instancing", "animation", "stage", "geometry", "materials", "lights", "cameras", "physics"]
        }
    }
    defaultPrim = "museum"
    doc = "The USD Museum's tour: sublayers ./museum.usda and adds the tour camera (/museum/cameras/tour_cam) and, after it, cameras to jump to (one per wing, the highlights, one per exhibit stop), the frame range, the museum's light (/museum/lighting: a key and a fill distant light) and each wing's exit door (inactive; the corridor joins the wings instead). OpenExec off; Rigging is ./rigging/tour.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 11839
    fallbackPrimTypes = {
        token[] DeptBall = ["FacilityBall", "Sphere", "Cube"]
        token[] FancyLamp = ["Cylinder"]
    }
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @./museum.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "museum"
{
    reorder nameChildren = ["cameras", "lighting", "wings", "corridors"]
    over "wings"
