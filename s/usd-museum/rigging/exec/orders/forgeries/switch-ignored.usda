#usda 1.0
(
    defaultPrim = "orders"
    doc = "Forgery switch-ignored on piece switch: switch held at rig1: at 72 the ball runs in the left lane, in its stays-empty zone, the right beacon empty. This is what a viewer with that bug shows; the correct exhibit is ../orders.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 542
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../orders.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "orders"
{
    over "Pieces"
    {
        over "Switch"
        {
            over "Rig"
            {
                over "Switch"
                {
                    token switch = "rig1"
                }
            }
        }
    }
}

