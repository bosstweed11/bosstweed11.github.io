#usda 1.0
(
    defaultPrim = "orders"
    doc = "Forgery rspin-ignored on piece spin: in:rspin ignored: the spun pointer turns like plain XYZ, its downward ghost empty. This is what a viewer with that bug shows; the correct exhibit is ../orders.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 542
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../orders.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "orders"
{
    over "Pieces"
    {
        over "Orders"
        {
            over "Rig"
            {
                over "Spin"
                {
                    double in:rspin = 0
                }
            }
        }
    }
}

