#usda 1.0
(
    defaultPrim = "orders"
    doc = "Forgery all-xyz on piece orders: every in:rotationOrder read as XYZ: only XYZ and the spun pointer fill their ghosts. This is what a viewer with that bug shows; the correct exhibit is ../orders.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 542
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../orders.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "orders"
{
    over "Pieces"
    {
        over "Orders"
        {
            over "Rig"
            {
                over "XZY"
                {
                    token in:rotationOrder = "XYZ"
                }

                over "YXZ"
                {
                    token in:rotationOrder = "XYZ"
                }

                over "YZX"
                {
                    token in:rotationOrder = "XYZ"
                }

                over "ZXY"
                {
                    token in:rotationOrder = "XYZ"
                }

                over "ZYX"
                {
                    token in:rotationOrder = "XYZ"
                }
            }
        }
    }
}

