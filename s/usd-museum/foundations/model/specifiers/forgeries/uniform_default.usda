#usda 1.0
(
    defaultPrim = "specifiers"
    doc = "Forgery uniform_default on piece uniform axis: the scroll stands upright, out of its ghost. This is what a viewer with that bug shows; the correct exhibit is ../specifiers.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../specifiers.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "specifiers"
{
    over "Pieces"
    {
        over "Uniform"
        {
            over "Spot"
            {
                over "Scroll"
                {
                    uniform token axis = "Y"
                }
            }
        }
    }
}

