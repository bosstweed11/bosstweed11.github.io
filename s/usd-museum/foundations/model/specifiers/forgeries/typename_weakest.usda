    startTimeCode = 1
    subLayers = [
        @../specifiers.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "specifiers"
{
    over "Pieces"
    {
        over "TypeName"
        {
            over "Spot"
            {
                over "Item"
                {
                    over Cube "Head"
                    {
                    }
                }
            }
        }
    }
}

