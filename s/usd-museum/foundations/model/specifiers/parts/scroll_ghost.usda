#usda 1.0
(
    "The scroll's ghost: a translucent cylinder lying along X, a little larger than the scroll."
    defaultPrim = "ScrollGhost"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "ScrollGhost" (
    kind = "component"
)
{
    def Scope "Looks"
    {
        def Material "Glass"
        {
            token outputs:surface.connect = </ScrollGhost/Looks/Glass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.44798842, 0.6382832, 0.8900054)
                float inputs:opacity = 0.22
                float inputs:roughness = 0.3
                color3f inputs:specularColor = (0.04, 0.04, 0.04)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

    def Cylinder "Body" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "X"
        float3[] extent = [(-0.18, -0.04, -0.04), (0.18, 0.04, 0.04)]
        double height = 0.36000000000000004
        rel material:binding = </ScrollGhost/Looks/Glass>
        double radius = 0.04
    }
}

