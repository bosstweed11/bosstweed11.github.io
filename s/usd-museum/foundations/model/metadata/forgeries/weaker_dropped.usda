#usda 1.0
(
    defaultPrim = "metadata"
    doc = "Forgery weaker_dropped on piece weaker key kept: an unglazed vase on the gold base. This is what a viewer with that bug shows; the correct exhibit is ../metadata.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../metadata.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "metadata"
{
    over "Pieces"
    {
        over "Weaker"
        {
            over "Vase"
            {
                float primvars:displayColor = None
            }
        }
    }
}

