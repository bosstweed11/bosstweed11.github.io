#usda 1.0
(
    defaultPrim = "metadata"
    doc = "Forgery arrays_dropped on piece clips merged: red vases on both blue bases (no assetPaths, no times). This is what a viewer with that bug shows; the correct exhibit is ../metadata.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../metadata.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "metadata"
{
    over "Pieces"
    {
        over "ClipA"
        {
            over "Vase"
            {
                color3f[] primvars:displayColor = [(0.630757, 0.000607054, 0.0109601)] (
                    interpolation = "constant"
                )
            }
        }

        over "ClipB"
        {
            over "Vase"
            {
                color3f[] primvars:displayColor = [(0.630757, 0.000607054, 0.0109601)] (
                    interpolation = "constant"
                )
            }
        }
    }
}

