#usda 1.0
(
    "The right stool: low, green."
    defaultPrim = "Stool"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Stool" (
    kind = "component"
)
{
    def Scope "Looks"
    {
        def Material "Paint"
        {
            token outputs:surface.connect = </Stool/Looks/Paint/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.033104766, 0.34239164, 0.073238954)
                float inputs:roughness = 0.55
                color3f inputs:specularColor = (0.04, 0.04, 0.04)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

    def Mesh "Seat" (
