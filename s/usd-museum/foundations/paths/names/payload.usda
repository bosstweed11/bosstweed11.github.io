#usda 1.0
(
    "USD Museum exhibit foundations.paths.names: busts reached through UTF-8 names, relative paths and a namespaced primvar. Built by src/build.py."
    defaultPrim = "Exhibit"
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @./names_layer.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

