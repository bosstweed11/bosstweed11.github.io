#usda 1.0
(
    defaultPrim = "names"
    doc = "Forgery normalized on piece nfc: the name normalized to the other spelling: a red bust in the right-hand ring. This is what a viewer with that bug shows; the correct exhibit is ../names.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../names.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "names"
{
    over "Pieces"
    {
        over "Nfc"
        {
            over "Spot"
            {
                over "Item"
                {
                    color3f[] primvars:displayColor = [(0.630757, 0.000607054, 0.0109601)] (
                        interpolation = "constant"
                    )
                    double3 xformOp:translate = (0.17, 0, 0)
                }
            }
        }
    }
}

