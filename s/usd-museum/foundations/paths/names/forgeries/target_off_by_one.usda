#usda 1.0
(
    defaultPrim = "names"
    doc = "Forgery target_off_by_one on piece binding: the relative target one level off: a red bust on the gold base. This is what a viewer with that bug shows; the correct exhibit is ../names.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../names.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "names"
{
    over "Pieces"
    {
        over "Binding"
        {
            over "Spot"
            {
                over "Item"
                {
                    custom rel material:binding = </names/Pieces/Binding/Spot/Looks/Gold>
                }
            }
        }
    }
}

