#usda 1.0
(
    defaultPrim = "names"
    doc = "Forgery connection_from_property on piece connection: the relative connection anchored at the shader: a red bust on the purple base. This is what a viewer with that bug shows; the correct exhibit is ../names.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../names.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "names"
{
    over "Pieces"
    {
        over "Connection"
        {
            over "Looks"
            {
                over "Tinted"
                {
                    over "Surface"
                    {
                        color3f inputs:diffuseColor = (0.630757, 0.000303527, 0.0103298)
                        color3f inputs:diffuseColor.connect = None
                    }
                }
            }
        }
    }
}

