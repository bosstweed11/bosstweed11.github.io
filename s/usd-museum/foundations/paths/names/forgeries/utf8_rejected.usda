#usda 1.0
(
    defaultPrim = "names"
    doc = "Forgery utf8_rejected on piece utf8: a UTF-8 name not found: an empty ghost. This is what a viewer with that bug shows; the correct exhibit is ../names.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../names.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "names"
{
    over "Pieces"
    {
        over "Utf8"
        {
            over "Spot"
            {
                over "Item" (
                    apiSchemas = None
                    kind = ""
                )
                {
                    custom rel material:binding = None
                    float purpose = None
                    float visibility = None

                    over "Looks" (
                        active = false
                    )
                    {
                    }

                    over "Torso" (
                        active = false
                    )
                    {
                    }

                    over "Head" (
                        active = false
                    )
                    {
                    }
                }
            }
        }
    }
}

