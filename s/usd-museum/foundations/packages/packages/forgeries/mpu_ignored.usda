#usda 1.0
(
    defaultPrim = "packages"
    doc = "Forgery mpu_ignored on piece original: a 100x globe swallows the bench and its ruler. This is what a viewer with that bug shows; the correct exhibit is ../packages.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../packages.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "packages"
{
    float3[] extentsHint = [(-26.56, 0, -27.62), (27.44, 54.8, 26.38)]

    over "Pieces"
    {
        over "Original"
        {
            over "Globe"
            {
                float3 xformOp:scale = (4.5, 4.5, 4.5)
            }
        }
    }
}

