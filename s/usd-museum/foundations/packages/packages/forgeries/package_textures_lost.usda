#usda 1.0
(
    defaultPrim = "packages"
    doc = "Forgery package_textures_lost on piece packed: a red packed globe. This is what a viewer with that bug shows; the correct exhibit is ../packages.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../packages.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "packages"
{
    over "Pieces"
    {
        over "Packed"
        {
            over "Globe"
            {
                over "Looks"
                {
                    over "PaintedWood"
                    {
                        over "Tex"
                        {
                            asset inputs:file = @./textures/base.png@
                        }
                    }

                    over "HouseWalls"
                    {
                        over "Tex"
                        {
                            asset inputs:file = @./textures/house.png@
                        }
                    }

                    over "Roof"
                    {
                        over "Tex"
                        {
                            asset inputs:file = @./textures/roof.png@
                        }
                    }
                }
            }
        }
    }
}

