#usda 1.0
(
    defaultPrim = "packages"
    doc = "Forgery localize_missed on piece localized: the twin's base and house red beside the original. This is what a viewer with that bug shows; the correct exhibit is ../packages.usda. Generated by usd-tour museum/src/export.py (usd-tour 0072026); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../packages.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "packages"
{
    over "Pieces"
    {
        over "Localized"
        {
            over "Globe"
            {
                over "Looks"
                {
                    over "PaintedWood"
                    {
                        over "Tex"
                        {
                            asset inputs:file = @0/base.png@
                        }
                    }

                    over "HouseWalls"
                    {
                        over "Tex"
                        {
                            asset inputs:file = @0/house.png@
                        }
                    }
                }
            }
        }
    }
}

