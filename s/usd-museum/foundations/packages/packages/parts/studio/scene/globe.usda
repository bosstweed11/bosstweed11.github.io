#usda 1.0
(
    "foundations.packages.packages: the studio original, in centimetres; its textures live in ../library/, outside the scene folder."
    defaultPrim = "Globe"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "Globe" (
    prepend apiSchemas = ["GeomModelAPI"]
    kind = "component"
)
{
    def Scope "Looks"
    {
        def Material "PaintedWood"
        {
            token outputs:surface.connect = </Globe/Looks/PaintedWood/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Globe/Looks/PaintedWood/Tex.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:fallback = (1, 0, 0, 1)
                asset inputs:file = @../library/base.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Globe/Looks/PaintedWood/St.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "HouseWalls"
        {
            token outputs:surface.connect = </Globe/Looks/HouseWalls/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Globe/Looks/HouseWalls/Tex.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:fallback = (1, 0, 0, 1)
                asset inputs:file = @../library/house.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Globe/Looks/HouseWalls/St.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Roof"
        {
            token outputs:surface.connect = </Globe/Looks/Roof/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Globe/Looks/Roof/Tex.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:fallback = (1, 0, 0, 1)
                asset inputs:file = @../library/roof.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Globe/Looks/Roof/St.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Snow"
        {
            token outputs:surface.connect = </Globe/Looks/Snow/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.96, 1)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "Pine"
        {
            token outputs:surface.connect = </Globe/Looks/Pine/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.45, 0.2)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Trunk"
        {
            token outputs:surface.connect = </Globe/Looks/Trunk/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.2, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Glass"
        {
            token outputs:surface.connect = </Globe/Looks/Glass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.58, 0.62)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 0.18
                float inputs:roughness = 0.05
                token outputs:surface
            }
        }
    }

