#usda 1.0
(
    defaultPrim = "formats"
    doc = "Forgery sublayers_reversed on piece sublayers: red shells on green bases. This is what a viewer with that bug shows; the correct exhibit is ../formats.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../formats.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "formats"
{
    over "Pieces"
    {
        over "usda"
        {
            over "Holder"
            {
                over "Case"
                {
                    color3f[] primvars:displayColor = [(0.63075715, 0.000607054, 0.010960094)] (
                        interpolation = "constant"
                    )
                }
            }
        }

        over "default"
        {
            over "Holder"
            {
                over "Case"
                {
                    color3f[] primvars:displayColor = [(0.63075715, 0.000607054, 0.010960094)] (
                        interpolation = "constant"
                    )
                }
            }
        }

        over "usdc"
        {
            over "Holder"
            {
                over "Case"
                {
                    color3f[] primvars:displayColor = [(0.63075715, 0.000607054, 0.010960094)] (
                        interpolation = "constant"
                    )
                }
            }
        }

        over "usdz"
        {
            over "Holder"
            {
                over "Case"
                {
                    color3f[] primvars:displayColor = [(0.63075715, 0.000607054, 0.010960094)] (
                        interpolation = "constant"
                    )
                }
            }
        }
    }
}

