#usda 1.0
(
    "foundations.files.formats: suitcase A, usda, authored Z-up in metres."
    defaultPrim = "Suitcase"
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Z"
)

def Xform "Suitcase" (
    kind = "component"
)
{
    def Scope "Looks"
    {
        def Material "Shell"
        {
            token outputs:surface.connect = </Suitcase/Looks/Shell/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Suitcase/Looks/Shell/Color.outputs:result>
                float inputs:roughness = 0.55
                color3f inputs:specularColor = (0.04, 0.04, 0.04)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }

            def Shader "Color"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                float3 inputs:fallback = (0.55, 0.55, 0.55)
                string inputs:varname = "displayColor"
                float3 outputs:result
            }
        }

        def Material "Trim"
        {
            token outputs:surface.connect = </Suitcase/Looks/Trim/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.09, 0.09, 0.1)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Rubber"
        {
            token outputs:surface.connect = </Suitcase/Looks/Rubber/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }

