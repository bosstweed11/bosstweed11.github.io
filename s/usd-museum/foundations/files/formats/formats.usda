#usda 1.0
(
    defaultPrim = "formats"
    doc = "Exhibit foundations.files.formats: One asset, every format. Look for: one view: every case fills its outline and matches its green base; the red outline stays empty; the packed label matches its print. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "formats" (
    prepend apiSchemas = ["AuthorshipAPI:claude", "AuthorshipAPI:build", "AssetPreviewsAPI"]
    assetInfo = {
        asset identifier = @./formats.usda@
        string name = "formats"
        dictionary previews = {
            dictionary thumbnails = {
                dictionary default = {
                    asset defaultImage = @./thumbnail.jpg@
                }
            }
        }
    }
    customData = {
        dictionary museum = {
            string[] belt = ["01.Arrival"]
            string id = "foundations.files.formats"
            string look_for = "one view: every case fills its outline and matches its green base; the red outline stays empty; the packed label matches its print"
            string[] spec = ["file_formats", "resource_interface", "composition"]
            string title = "One asset, every format"
            string wg = "core"
        }
    }
    kind = "assembly"
    prepend payload = @./payload.usda@
)
{
    uniform string authorship:build:created = "2026-11-13T20:04:05-08:00"
    uniform string[] authorship:build:creator = ["usd-tour museum/src/export.py"]
    uniform string authorship:build:description = "Written through OpenUSD's Python API by usd-tour's build and export scripts (written by Claude Opus 5.5)."
    uniform string authorship:build:digitalSourceType = "http://cv.iptc.org/newscodes/digitalsourcetype/algorithmicMedia"
    uniform string[] authorship:build:inputs = ["source", "usd-tour 5103439"]
    uniform string authorship:build:softwarePackage = "OpenUSD"
    uniform string authorship:build:softwareVersion = "26.11"
    uniform string authorship:build:usageTerms = "CC0-1.0"
    uniform string authorship:claude:created = "2026-11-13T20:04:05-08:00"
    uniform string[] authorship:claude:creator = ["Claude Opus 5.5 (Anthropic)"]
    uniform string authorship:claude:description = "Claude Opus 5.5, working in Claude Code, built every prim in this museum: it designed the exhibits and wrote the usd-tour scripts that author them."
    uniform string authorship:claude:digitalSourceType = "http://cv.iptc.org/newscodes/digitalsourcetype/trainedAlgorithmicMedia"
    uniform string[] authorship:claude:inputs = ["source", "usd-tour 5103439"]
    uniform string authorship:claude:softwarePackage = "com.anthropic.claude"
    uniform string authorship:claude:softwareVersion = "claude-opus-5-5"
    uniform string authorship:claude:usageTerms = "CC0-1.0"
    float3[] extentsHint = [(-2.1, 0, -1.5), (2.1, 2.55, -0.314)]

    over "Pieces"
    {
        over "usda" (
            customData = {
                dictionary museum = {
                    string[] belt = ["01.Arrival/usda"]
                    string[] features = ["FMT-USDA.files", "META-UPAXIS"]
                    string[] forgeries = ["upaxis_ignored"]
                    string reference = "an ink outline of the standing case; a green base"
                    string[] spec = ["file_formats#text"]
                }
            }
            doc = "a suitcase in a usda layer authored Z-up in metres; the holder adds the rotateX -90 corrective"
        )
        {
        }

        over "default" (
            customData = {
                dictionary museum = {
                    string[] belt = ["01.Arrival/default prim"]
                    string[] features = ["META-DEFAULTPRIM", "COMP-REF-SUBROOT"]
                    string[] forgeries = ["whole_depot"]
                    string reference = "an ink outline for the parcel; a red outline in the decoy's place that must stay empty"
                    string[] spec = ["composition#references", "document_data_model#layer-specs"]
                }
            }
            doc = "a reference with no prim path to depot.usda, whose defaultPrim is the sub-root /Depot/Parcel"
        )
        {
        }

        over "usdc" (
            customData = {
                dictionary museum = {
                    string[] belt = ["01.Arrival/usdc"]
                    string[] features = ["FMT-USDC.files", "META-MPU"]
                    string[] forgeries = ["cm_ignored", "usdc_unread"]
                    string reference = "an ink outline of the case at the same size as the others"
                    string[] spec = ["file_formats#binary"]
                }
            }
            doc = "a suitcase in a usdc crate authored in centimetres (metersPerUnit 0.01); the holder scales by 0.01"
        )
        {
        }

        over "usdz" (
            customData = {
                dictionary museum = {
                    string[] belt = ["01.Arrival/usdz"]
                    string[] features = ["FMT-USDZ", "ASSET-PACKAGE"]
                    string[] forgeries = ["package_texture"]
                    string reference = "the label's print on the pedestal front"
                    string[] spec = ["resource_interface#packaged-resources"]
                }
            }
            doc = "a suitcase packaged as usdz with its luggage label's texture inside the package"
        )
        {
        }
    }
}

