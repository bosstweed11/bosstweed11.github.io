#usda 1.0
(
    defaultPrim = "encodings"
    doc = "Forgery exponent_sign_lost on piece 1.5e-1: a marble rattling in its ghost (a digit misread). This is what a viewer with that bug shows; the correct exhibit is ../encodings.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 96
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../encodings.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "encodings"
{
    over "Pieces"
    {
        over "Grammar"
        {
            over "Text"
            {
                over "Exponent"
                {
                    float3[] extent = [(-0.015, -0.015, -0.015), (0.015, 0.015, 0.015)]
                    double radius = 0.015
                }
            }
        }
    }
}

