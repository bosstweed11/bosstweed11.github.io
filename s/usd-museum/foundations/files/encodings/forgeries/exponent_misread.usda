#usda 1.0
(
    defaultPrim = "encodings"
    doc = "Forgery exponent_misread on piece 1.5e-1: a sphere ten times its ghost's size. This is what a viewer with that bug shows; the correct exhibit is ../encodings.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 96
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../encodings.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "encodings"
{
    over "Pieces"
    {
        over "Grammar"
        {
            over "Text"
            {
                over "Exponent"
                {
                    float3[] extent = [(-1.5, -1.5, -1.5), (1.5, 1.5, 1.5)]
                    double radius = 1.5
                }
            }
        }
    }
}

