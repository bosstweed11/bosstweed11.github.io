#usda 1.0
(
    defaultPrim = "encodings"
    doc = 'Forgery escape_literal on piece "t\\x69nt": a red can on the green base. This is what a viewer with that bug shows; the correct exhibit is ../encodings.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md.'
    endTimeCode = 96
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../encodings.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "encodings"
{
    over "Pieces"
    {
        over "Grammar"
        {
            over "Text"
            {
                over "Looks"
                {
                    over "Can"
                    {
                        over "Tint"
                        {
                            string inputs:varname = "t\\x69nt"
                        }
                    }
                }
            }
        }
    }
}

