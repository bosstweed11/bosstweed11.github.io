#usda 1.0
(
    defaultPrim = "Body"
)

def Xform "Body"
{
    def Xform "Lift"
    {
        def Mesh "Box"
        {
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 3, 2, 2, 3, 5, 4, 4, 5, 7, 6, 6, 7, 1, 0, 1, 7, 5, 3, 6, 0, 2, 4]
            point3f[] points = [(-0.1, 0, 0.1), (0.1, 0, 0.1), (-0.1, 0.2, 0.1), (0.1, 0.2, 0.1), (-0.1, 0.2, -0.1), (0.1, 0.2, -0.1), (-0.1, 0, -0.1), (0.1, 0, -0.1)]
            float3[] extent = [(-0.1, 0, -0.1), (0.1, 0.2, 0.1)]
            uniform token subdivisionScheme = "none"
            color3f[] primvars:displayColor = [(0.72, 0.52, 0.3)]
        }
        def Mesh "Label" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            point3f[] points = [(-0.09, 0.03, 0.106), (0.09, 0.03, 0.106), (0.09, 0.17, 0.106), (-0.09, 0.17, 0.106)]
            float3[] extent = [(-0.09, 0.03, 0.106), (0.09, 0.17, 0.106)]
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
                interpolation = "vertex"
            )
            uniform token subdivisionScheme = "none"
            rel material:binding = </Body/Lift/Looks/Label>
        }
        def Scope "Looks"
        {
            def Material "Label"
            {
                token outputs:surface.connect = </Body/Lift/Looks/Label/Surface.outputs:surface>
                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor.connect = </Body/Lift/Looks/Label/Tex.outputs:rgb>
                    color3f inputs:emissiveColor.connect = </Body/Lift/Looks/Label/Tex.outputs:rgb>
                    token outputs:surface
                }
                def Shader "St"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    string inputs:varname = "st"
                    float2 outputs:result
                }
                def Shader "Tex"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./textures/ver_0_8_0.png@
                    float2 inputs:st.connect = </Body/Lift/Looks/Label/St.outputs:result>
                    token inputs:sourceColorSpace = "sRGB"
                    float3 outputs:rgb
                }
            }
        }
            double xformOp:translateY.timeSamples = {
                101: 0.42,
                146: 0,
            }
            uniform token[] xformOpOrder = ["xformOp:translateY"]
    }
}
