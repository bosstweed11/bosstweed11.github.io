#usda 1.0
(
    defaultPrim = "twins"
    doc = "Forgery quat_order on piece angles/quatf: a blue quatf arrow on the red tick, far from its ghost. This is what a viewer with that bug shows; the correct exhibit is ../twins.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../twins.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "twins"
{
    over "Pieces"
    {
        over "Arrows"
        {
            over "quatfUsdc"
            {
                over "Station"
                {
                    quatf xformOp:orient = (0.9848077, 0.17364818, 0, 0)
                }
            }
        }
    }
}

