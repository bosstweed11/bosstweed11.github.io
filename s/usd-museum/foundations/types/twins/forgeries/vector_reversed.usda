#usda 1.0
(
    defaultPrim = "twins"
    doc = "Forgery vector_reversed on piece roles/vector3f: a blue tile on the yellow base. This is what a viewer with that bug shows; the correct exhibit is ../twins.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../twins.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "twins"
{
    over "Pieces"
    {
        over "Roles"
        {
            over "vector3"
            {
                over "Usdcf"
                {
                    over "Station"
                    {
                        over "Tile"
                        {
                            color3f[] primvars:displayColor = [(0.125, 0.75, 0.9375), (0.125, 0.75, 0.9375), (0.125, 0.75, 0.9375), (0.125, 0.75, 0.9375), (0.125, 0.75, 0.9375), (0.125, 0.75, 0.9375)] (
                                interpolation = "uniform"
                            )
                        }
                    }
                }
            }
        }
    }
}

