#usda 1.0
(
    defaultPrim = "twins"
    doc = "Forgery half_angle_lost on piece angles/half: a blue half arrow on the red tick, its ghost half empty. This is what a viewer with that bug shows; the correct exhibit is ../twins.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../twins.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "twins"
{
    over "Pieces"
    {
        over "Arrows"
        {
            over "halfUsdc"
            {
                over "Station"
                {
                    half xformOp:rotateZ = 0
                }
            }
        }
    }
}

