#usda 1.0
(
    defaultPrim = "twins"
    doc = "Forgery half_as_float on piece lengths/half3: the blue half3 bar stops far below its ghost's top. This is what a viewer with that bug shows; the correct exhibit is ../twins.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../twins.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "twins"
{
    over "Pieces"
    {
        over "Lengths"
        {
            over "half3"
            {
                over "Usdc"
                {
                    over "Station"
                    {
                        half3 xformOp:scale = (1, 0.25, 1)
                    }
                }
            }
        }
    }
}

