#usda 1.0
(
    "foundations.types.twins: one station per foundational type (twin.usdc is this layer exported as a crate). Every value is exactly representable in half. The stations' colors come from the exhibit's holders (amber for usda, blue for usdc), except the roles, whose color is the value."
    defaultPrim = "Twin"
)

