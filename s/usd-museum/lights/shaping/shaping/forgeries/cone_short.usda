#usda 1.0
(
    defaultPrim = "shaping"
    doc = "Forgery cone_short on piece wide: the wide cone 4 degrees short: a dark gap inside its ring. This is what a viewer with that bug shows; the correct exhibit is ../shaping.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../shaping.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "shaping"
{
    over "Pieces"
    {
        over "Wide"
        {
            over "Light"
            {
                float inputs:shaping:cone:angle = 11
            }
        }
    }
}

