#usda 1.0
(
    defaultPrim = "shaping"
    doc = "Forgery cone_full_angle on piece narrow: the angle read as the full angle: each pool half size inside its ring. This is what a viewer with that bug shows; the correct exhibit is ../shaping.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../shaping.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "shaping"
{
    over "Pieces"
    {
        over "Narrow"
        {
            over "Light"
            {
                float inputs:shaping:cone:angle = 4
            }
        }

        over "Wide"
        {
            over "Light"
            {
                float inputs:shaping:cone:angle = 7.5
            }
        }
    }
}

