#usda 1.0
(
    defaultPrim = "intensity"
    doc = "Forgery normalize_ignored on piece normalize: normalize ignored: the area counts, both cards near black. This is what a viewer with that bug shows; the correct exhibit is ../intensity.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../intensity.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "intensity"
{
    over "Pieces"
    {
        over "NormSmall"
        {
            over "Light"
            {
                bool inputs:normalize = 0
            }
        }

        over "NormLarge"
        {
            over "Light"
            {
                bool inputs:normalize = 0
            }
        }
    }
}

