#usda 1.0
(
    defaultPrim = "intensity"
    doc = "Forgery exposure_halved on piece exposure: the +1 light at half the plain card: a dim card beside the 2x swatch. This is what a viewer with that bug shows; the correct exhibit is ../intensity.usda. Generated by usd-tour museum/src/export.py (usd-tour d664ad2); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../intensity.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "intensity"
{
    over "Pieces"
    {
        over "ExposurePlus1"
        {
            over "Light"
            {
                float inputs:exposure = 0
                float inputs:intensity = 900
            }
        }
    }
}

