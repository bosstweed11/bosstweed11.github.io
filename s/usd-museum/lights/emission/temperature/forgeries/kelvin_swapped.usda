#usda 1.0
(
    defaultPrim = "temperature"
    doc = "Forgery kelvin_swapped on piece k2700: 2700 and 10000 K swapped: a cool card by the warm swatch, warm by the cool. This is what a viewer with that bug shows; the correct exhibit is ../temperature.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../temperature.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "temperature"
{
    over "Pieces"
    {
        over "K2700"
        {
            over "Light"
            {
                float inputs:colorTemperature = 10000
            }
        }

        over "K10000"
        {
            over "Light"
            {
                float inputs:colorTemperature = 2700
            }
        }
    }
}

