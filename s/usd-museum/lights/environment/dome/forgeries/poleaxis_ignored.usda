#usda 1.0
(
    defaultPrim = "dome"
    doc = "Forgery poleaxis_ignored on piece poleaxis: DomeLight_1's poleAxis ignored: the sky rolled, the sun out of its ring. This is what a viewer with that bug shows; the correct exhibit is ../dome.usda. Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    endTimeCode = 192
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../dome.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "dome"
{
    over "Pieces"
    {
        over "Sky"
        {
            over "DomeLight_1"
            {
                uniform token poleAxis = "scene"
            }
        }
    }
}

