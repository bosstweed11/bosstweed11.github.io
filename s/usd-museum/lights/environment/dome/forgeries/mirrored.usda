#usda 1.0
(
    defaultPrim = "dome"
    doc = "Forgery mirrored on piece orientation: the map mirrored: the sun and marker swap sides, out of their rings. This is what a viewer with that bug shows; the correct exhibit is ../dome.usda. Generated by usd-tour museum/src/export.py (usd-tour 5103439); do not edit. See README.md."
    endTimeCode = 192
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @../dome.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "dome"
{
    over "Pieces"
    {
        over "Sky"
        {
            over "DomeLight"
            {
                float3 xformOp:scale:mirror = (-1, 1, 1)
                uniform token[] xformOpOrder = ["xformOp:rotateY", "xformOp:scale:mirror"]
            }

            over "DomeLight_1"
            {
                float3 xformOp:scale:mirror = (-1, 1, 1)
                uniform token[] xformOpOrder = ["xformOp:rotateY", "xformOp:rotateX", "xformOp:scale:mirror"]
            }
        }
    }
}

