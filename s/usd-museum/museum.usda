#usda 1.0
(
    defaultPrim = "museum"
    doc = "The USD Museum: the 10 wings an exec-off tour joins (foundations, composition, instancing, animation, stage, geometry, materials, lights, cameras, physics), placed and timed as usd-tour's compose.py places them, and the corridors between them. Rigging runs with OpenExec on and is its own tour (./rigging/tour.usda). Generated by usd-tour museum/src/export.py (usd-tour 91b777d); do not edit. See README.md."
    fallbackPrimTypes = {
        token[] DeptBall = ["FacilityBall", "Sphere", "Cube"]
        token[] FancyLamp = ["Cylinder"]
    }
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

