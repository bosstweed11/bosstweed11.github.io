#usda 1.0
(
    defaultPrim = "World"
    startTimeCode = 10
    endTimeCode = 34
    framesPerSecond = 24
    timeCodesPerSecond = 24
    upAxis = "Y"
)
def Xform "World" {
    def Cube "Cube" {
        double size = 2
        double3 xformOp:translate.timeSamples = {10: (-2,0,0), 22: (0,1,0), 34: (2,0,0)}
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor.timeSamples = {10: [(1,0.1,0.1)], 34: [(0.1,0.2,1)]}
    }
    def Xform "Rig" {
        double3 xformOp:translate.timeSamples = {10: (0,0,9), 34: (2,1,12)}
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Camera "Camera" {
            float focalLength.timeSamples = {10: 35, 34: 50}
            float horizontalAperture = 36
            float verticalAperture = 24
            float2 clippingRange.timeSamples = {10: (0.5,100), 34: (1,200)}
        }
    }
}
