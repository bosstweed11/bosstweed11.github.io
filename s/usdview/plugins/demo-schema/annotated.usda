#usda 1.0
(
    doc = """DemoAnnotationAPI sample. Open with
    ?plugin=./plugins/demo-schema/plugInfo.json&scene=./plugins/demo-schema/annotated.usda
    Ball authors both attributes; Box shows the schema's fallbacks."""
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Sphere "Ball" (
        prepend apiSchemas = ["DemoAnnotationAPI"]
    )
    {
        color3f annotation:color = (0.2, 0.6, 1)
        string annotation:text = "One schema.usda, generated by both ports"
        color3f[] primvars:displayColor = [(0.2, 0.6, 1)]
        double radius = 0.5
        double3 xformOp:translate = (-0.75, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "Box" (
        prepend apiSchemas = ["DemoAnnotationAPI"]
    )
    {
        color3f[] primvars:displayColor = [(1, 0.8, 0)]
        double size = 0.8
        double3 xformOp:translate = (0.75, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
